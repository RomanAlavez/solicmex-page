{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist"
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
        "@components/*": [
          "./src/components/*"
        ],
        "@sections/*": [
          "./src/sections/*"
        ],
        "@types/*": [
          "./src/types/*"
        ],
        "@assets/*": [
          "./src/assets/*"
        ],
        
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  }
}