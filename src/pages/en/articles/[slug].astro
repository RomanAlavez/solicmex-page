---
import Layout from "@/layouts/Layout.astro";
import ArticleBlog from "@/components/articles/ArticleBlog.astro";
import type { ArticleBlog as ArticleBlogType } from "@/types/types.d.ts";
import en from "@/i18n/en.json";
import es from "@/i18n/es.json";

export function getStaticPaths() {
  const spanishArticlesById = new Map(
    es.ARTICLES.ARTICLES_LIST.map((article: ArticleBlogType) => [article.ID, article])
  );

  return en.ARTICLES.ARTICLES_LIST.flatMap((article: ArticleBlogType) => {
    const canonicalSlug = article.LINK ?? article.ID;
    const paths = [
      {
        params: { slug: canonicalSlug },
        props: { article },
      },
    ];

    const spanishSlug = spanishArticlesById.get(article.ID)?.LINK ?? article.ID;

    if (spanishSlug !== canonicalSlug) {
      paths.push({
        params: { slug: spanishSlug },
        props: { article },
      });
    }

    return paths;
  });
}

const { article } = Astro.props;
---

<Layout
  currentLanguage="en"
  title={article.TITLE}
  description={article.DESCRIPTION}
  nav={en.NAV}
  foot={en.FOOTER}
>
  <ArticleBlog
    article={article}
    backHref="/en/"
    backLabel={en.ARTICLES.BACK_LABEL}
  />
</Layout>