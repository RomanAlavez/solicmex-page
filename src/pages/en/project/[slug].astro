---
import Layout from "@/layouts/Layout.astro";
import enData from "@/i18n/en.json";
import slugify from "@/utils/utils.js";
import ProjectHeader from "@/components/project/ProjectHeader.astro";
import ProjectDescription from "@/components/project/ProjectDescription.astro";
import ProjectDetails from "@/components/project/ProjectDetails.astro";
import ProjectGallery from "@/components/project/ProjectGallery.astro";

const i18n = enData;
const { currentLocale } = Astro;

export async function getStaticPaths() {
  const projects = enData.PROJECTS.PROJECTS_LIST;
  return projects.map((project) => ({
    params: { slug: slugify(project.NAME) },
    props: { project },
  }));
}

const { project } = Astro.props;

const backHref = currentLocale === "en" ? "/en/#projects" : "/#projects";
const backLabel = currentLocale === "en" ? "Back to projects" : "Volver a proyectos";
---

<Layout
  currentLanguage={currentLocale}
  title={`${project.NAME} | ${i18n.SEO_TITLE}`}
  description={project.DESCRIPTION || i18n.SEO_DESCRIPTION}
  nav={i18n.NAV}
  foot={i18n.FOOTER}
>
  <main class="relative w-full min-h-screen pt-14 pb-24 text-white overflow-hidden">

    <!-- Fondo ambiental -->
    <div class="fixed inset-0 -z-10 pointer-events-none">
      <div
        class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[500px] rounded-full opacity-10"
        style="background: radial-gradient(ellipse, rgba(6,182,212,0.35) 0%, transparent 70%);"
      ></div>
    </div>

    <div class="max-w-5xl mx-auto px-4 sm:px-8 flex flex-col gap-0">

      <!-- Volver -->
      <a
        href={backHref}
        class="group self-start flex items-center gap-2 text-[11px] tracking-widest uppercase text-white/35 hover:text-cyan-300 transition-colors duration-200 mt-6 mb-8"
      >
        <svg class="w-3 h-3 group-hover:-translate-x-0.5 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        {backLabel}
      </a>

      <article class="flex flex-col gap-1">
        <ProjectHeader project={project} />
        <div class="flex flex-col gap-10 pt-10">
          <ProjectDescription project={project} currentLanguage={currentLocale} />
          <ProjectDetails project={project} currentLanguage={currentLocale} />
          <ProjectGallery project={project} currentLanguage={currentLocale} />
        </div>
      </article>

    </div>
  </main>
</Layout>