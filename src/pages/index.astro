---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/sections/Hero.astro";
import Services from "@/sections/Services.astro";
import { getI18N } from "@/i18n";
import ArticlesHome from "@/components/articles/ArticlesHome.astro";
import type { ArticleBlog } from "@/types/types.d.ts";

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });
const articles: ArticleBlog[] = i18n.ARTICLES.ARTICLES_LIST;
---

<Layout
  currentLanguage={currentLocale}
  title={i18n.SEO_TITLE}
  description={i18n.SEO_DESCRIPTION}
  nav={i18n.NAV}
  foot={i18n.FOOTER}
>
  <div class="w-full flex flex-col text-primary gap-3">
    <Hero
      prevServices={i18n.PREV_SERVICES}
      title={i18n.HERO.TITLE}
      subtitle={i18n.HERO.SUBTITLE}
      description={i18n.HERO.DESCRIPTION}
      quote={i18n.QUOTE}
      button={i18n.HERO.BUTTON}
    />
    <AboutUs ABOUT_US={i18n.ABOUT_US} />
    <Services SERVICES={i18n.SERVICES} />

    <ArticlesHome
      articles={articles}
      text={i18n.ARTICLES_PREVIEW}
      max={3}
      articlesHref="articles"
    />
  
  </div>
</Layout>