---
import { SERVICES } from "@/lib/mocks.js";
import ServiceCard from "@/components/ServiceCard.astro";

const { text, services } = Astro.props;
---

<section
  id="services"
  class="flex flex-col gap-10 items-center justify-center text-white text-center w-full min-h-screen px-12"
>
  <h3 class="font-semibold text-7xl">{text.TITLE}</h3>
  <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 w-full">
    {
      services?.map(
        (service: { NAME: string; DESCRIPTION: string; ICON: string }) => (
          <ServiceCard
            name={service.NAME}
            description={service.DESCRIPTION}
            icon={service.ICON}
          />
        ),
      )
    }
  </section>
</section>
