---
import ServiceCardPreview from "@/components/service-card-preview";
import type { Services } from "@/types/types";
import {
  Droplets,
  SprayCan,
  MapPinned,
  Gauge,
  Route,
  Database,
  BellRing,
  ShieldAlert,
  Wind,
  Flame,
  ArrowRight,
} from "lucide-react";

const { SERVICES } = Astro.props as { SERVICES: Services };

const ICONS: Record<string, any> = {
  SprinklerIcon: Droplets,
  WaterMistIcon: SprayCan,
  HydrantIcon: MapPinned,
  PumpIcon: Gauge,
  PipeIcon: Route,
  TankIcon: Database,
  AlarmIcon: BellRing,
  RiskIcon: ShieldAlert,
  GasIcon: Wind,
};
---

<section
  id="services"
  class="relative w-full bg-slate-50 py-16 sm:py-20 lg:py-24"
>
  <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-10 max-w-2xl sm:mb-14">
      <span
        aria-hidden="true"
        class="block h-1 w-14 rounded-full bg-dark-primary"></span>

      <h2
        class="mt-5 text-3xl font-bold tracking-tight text-primary sm:text-4xl lg:text-5xl"
      >
        {SERVICES.TITLE}
      </h2>
    </div>

    <div class="services-fan">
      {
        SERVICES.SERVICES_LIST.map((service) => {
          const Icon = ICONS[service.ICON] ?? Flame;

          return (
            <ServiceCardPreview
              service={service}
              icon={Icon}
            />
          );
        })
      }
    </div>
  </div>
</section>
