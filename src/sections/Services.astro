---
import ServiceCard from "@/components/ServiceCard.astro";

const { text, services } = Astro.props;
---

<section
  id="services"
  class="services-section relative flex flex-col gap-16 items-center justify-center text-white text-center w-full min-h-screen px-8 md:px-16 py-24 overflow-hidden"
>
  <!-- Ambient background blobs -->
  <div class="pointer-events-none absolute inset-0 -z-10">
    <div class="blob blob-1"></div>
    <div class="blob blob-2"></div>
    <div class="grid-overlay"></div>
  </div>

  <!-- Header -->
  <div class="header-group flex flex-col gap-4 items-center">
    <span class="eyebrow">— Lo que ofrecemos</span>
    <h3 class="section-title">{text.TITLE}</h3>
    {text.SUBTITLE && <p class="section-subtitle">{text.SUBTITLE}</p>}
  </div>

  <!-- Cards grid -->
  <div class="cards-grid">
    {
      services?.map(
        (
          service: { NAME: string; DESCRIPTION: string; ICON: string },
          i: number,
        ) => (
          <ServiceCard
            name={service.NAME}
            description={service.DESCRIPTION}
            icon={service.ICON}
            index={i}
          />
        ),
      )
    }
  </div>
</section>

<style>
  /* ── Ambient blobs ── */
  .blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    opacity: 0.18;
    animation: drift 18s ease-in-out infinite alternate;
  }
  .blob-1 {
    width: 600px;
    height: 600px;
    top: -10%;
    left: -10%;
    animation-duration: 20s;
  }
  .blob-2 {
    width: 500px;
    height: 500px;
    bottom: -10%;
    right: -10%;
    animation-duration: 25s;
    animation-direction: alternate-reverse;
  }
  @keyframes drift {
    from {
      transform: translate(0, 0) scale(1);
    }
    to {
      transform: translate(40px, 30px) scale(1.08);
    }
  }

  /* ── Subtle grid overlay ── */
  .grid-overlay {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 60px 60px;
  }

  /* ── Eyebrow ── */
  .eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.45);
    font-family: "DM Mono", monospace, sans-serif;
  }

  /* ── Section title ── */
  .section-title {
    font-size: clamp(2.8rem, 6vw, 5rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    background: linear-gradient(
      135deg,
      #ffffff 0%,
      rgba(255, 255, 255, 0.6) 100%
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* ── Subtitle ── */
  .section-subtitle {
    max-width: 520px;
    color: rgba(255, 255, 255, 0.5);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  /* ── Grid ── */
  .cards-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 1.25rem;
    width: 100%;
    max-width: 1280px;
  }
  @media (min-width: 640px) {
    .cards-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .cards-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
