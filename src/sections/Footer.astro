---
import NoiseTexture from "@/components/Noise.astro";
type FooterProps = {
  DESCRIPTION: string;
  LINKS: string;
  LINK_ABOUT_US: string;
  LINK_WHY_US: string;
  LINK_SERVICES: string;
  LINK_CONTACT: string;
  CONTACT: string;
  CERTIFICATIONS: string;
  CERTIFICATION_1: string;
  CERTIFICATION_2: string;
  CERTIFICATION_3: string;
  CERTIFICATION_4: string;
  COPYRIGHT: string;
  PRIVACY_POLICY: string;
  TERMS_OF_SERVICE: string;
};

const {
  DESCRIPTION,
  LINKS,
  LINK_ABOUT_US,
  LINK_WHY_US,
  LINK_SERVICES,
  LINK_CONTACT,
  CONTACT,
  CERTIFICATIONS,
  CERTIFICATION_1,
  CERTIFICATION_2,
  CERTIFICATION_3,
  CERTIFICATION_4,
  COPYRIGHT,
  PRIVACY_POLICY,
  TERMS_OF_SERVICE,
} = Astro.props as FooterProps;
---

<section
  id="footer"
  class="relative w-full bg-primary to-black overflow-hidden rounded-2xl shadow-2xl shadow-black/60"
>
  <NoiseTexture
    class="w-full opacity-5 mix-blend-screen h-full absolute top-0 left-0"
  />

  <div
    class="relative z-10 max-w-7xl mx-auto px-6 sm:px-10 lg:px-16 pt-14 pb-8"
  >
    <div
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-12 mb-12"
    >
      <div class="lg:col-span-2 flex flex-col gap-5">
        <div class="flex items-center gap-3">
          <div
            class="relative flex items-center justify-center size-10 rounded-full overflow-hidden bg-white shrink-0 p-0.5"
          >
            <img
              src="/logo-solicmex.webp"
              alt="SolicMex Logo"
              class="w-full h-full"
              draggable="false"
            />
          </div>
          <span
            class="font-extrabold text-xl uppercase tracking-widest bg-clip-text text-white"
          >
            SolicMex
          </span>
        </div>

        <p class="text-white/80 text-sm leading-relaxed max-w-sm">
          {DESCRIPTION}
        </p>
      </div>

      <div class="flex flex-col gap-4">
        <h4 class="text-xs font-bold uppercase tracking-[0.2em] text-primary">
          {LINKS}
        </h4>
        <nav class="flex flex-col gap-2.5">
          {
            [
              { label: LINK_ABOUT_US, href: "#about" },
              { label: LINK_WHY_US, href: "#why-us" },
              { label: LINK_SERVICES, href: "#services" },
              { label: LINK_CONTACT, href: "#contact" },
            ].map(({ label, href }) => (
              <a
                href={href}
                class="group flex items-center gap-2 text-sm text-white/80 hover:text-white transition-colors duration-200"
              >
                <span class="w-0 group-hover:w-3 h-px bg-primary transition-all duration-300 shrink-0" />
                {label}
              </a>
            ))
          }
        </nav>
      </div>

      <div class="flex flex-col gap-4">
        <h4 class="text-xs font-bold uppercase tracking-[0.2em] text-primary">
          {CERTIFICATIONS}
        </h4>
        <ul class="flex flex-col gap-2.5">
          {
            [
              CERTIFICATION_1,
              CERTIFICATION_2,
              CERTIFICATION_3,
              CERTIFICATION_4,
            ].map((cert) => (
              <li class="flex items-start gap-2 text-sm text-white/80">
                <span class="mt-1 size-1.5 rounded-full bg-primary/70 shrink-0" />
                {cert}
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <hr class="mb-6 text-white" />

    <div
      class="flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-white/90"
    >
      <span>{COPYRIGHT}</span>
      <div class="flex items-center gap-4">
        <a
          href="/privacy"
          class="hover:text-white transition-colors duration-200"
        >
          {PRIVACY_POLICY}
        </a>
        <span class="text-white/80">|</span>
        <a
          href="/terms"
          class="hover:text-white transition-colors duration-200"
        >
          {TERMS_OF_SERVICE}
        </a>
      </div>
    </div>
  </div>
</section>
