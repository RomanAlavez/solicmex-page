---
/**
 * Gallery.astro
 *
 * Each `project` is rendered as a named card block containing
 * its own ProjectLightbox image grid (2–3 cols internally).
 *
 * Outer layout: 1 col mobile · 2 col md+ — gives the inner grids room.
 *
 * Usage:
 *   <Gallery projects={projects} text={translations.GALLERY} />
 */

import ProjectLightbox from "@/components/project/ProjectLightBox";

interface Project {
  NAME: string;
  IMAGES: string[];
  [key: string]: unknown;
}

interface Props {
  projects: Project[];
  text: {
    SUBTITLE?: string;
    TITLE: string;
    DESCRIPTION: string;
  };
}

const { projects, text } = Astro.props;
const subtitle = text.SUBTITLE ?? "Our Work";
---

<section
  id="gallery"
  class="relative w-full flex flex-col justify-center px-5 py-24 overflow-hidden text-white"
>

  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10 overflow-hidden"
  >

    <div
      class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-white/10 to-transparent"
    ></div>
  </div>

  <div class="max-w-6xl mx-auto w-full flex flex-col gap-16">

    <!-- ── Section header ──────────────────────────────────── -->
    <div class="flex flex-col items-center text-center gap-4">
      <span
        class="bg-gradient-to-r from-white to-cyan-400 bg-clip-text text-transparent font-semibold tracking-widest uppercase text-sm"
      >
        {subtitle}
      </span>

      <h2 class="text-4xl md:text-5xl font-bold text-white leading-tight">
        {text.TITLE}
      </h2>

      <div class="h-1 w-20 bg-gradient-to-r from-cyan-400 to-white/30 rounded-full"></div>

      <p class="max-w-2xl text-white/70 text-lg leading-relaxed mt-2">
        {text.DESCRIPTION}
      </p>
    </div>


    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {
        projects.map((project, idx) => (
          <div class="group relative flex flex-col rounded-2xl overflow-hidden border border-white/10 bg-white/[0.04]  hover:bg-white/[0.06] transition-all duration-500 shadow-lg hover:shadow-black/10 hover:shadow-xl">

            <div class="flex items-center justify-between px-5 pt-5 pb-4 border-b border-white/[0.06]">
              <div class="flex items-center gap-3">
                <span class="text-xs font-black font-mono text-white/20 tabular-nums">
                  {String(idx + 1).padStart(2, "0")}
                </span>
                <h3 class="text-sm font-bold tracking-wide text-white/90 uppercase">
                  {project.NAME}
                </h3>
              </div>

              <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-cyan-400/10 border border-cyan-400/20 text-cyan-400 text-[10px] font-bold tracking-widest uppercase">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round"
                    d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M3.75 19.5h16.5M3.75 6.75h.007v.008H3.75V6.75zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zM16.5 6.75h.007v.008h-.007V6.75zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
                </svg>
                {project.IMAGES.length}
              </span>
            </div>


            <div class="p-4">
              <ProjectLightbox
                images={project.IMAGES}
                name={project.NAME}
                client:load
              />
            </div>
          </div>
        ))
      }
    </div>

    <!-- ── Bottom divider with project count ───────────────── -->
    <div class="flex items-center gap-4">
      <div class="h-px flex-1 bg-gradient-to-r from-white/10 to-transparent"></div>
      <span class="text-white/30 text-xs font-bold tracking-widest uppercase whitespace-nowrap">
        {projects.length} {projects.length === 1 ? "proyecto" : "proyectos"} · {projects.reduce((acc, p) => acc + p.IMAGES.length, 0)} imagénes
      </span>
      <div class="h-px flex-1 bg-gradient-to-l from-white/10 to-transparent"></div>
    </div>

  </div>
</section>