---
import sanitizeHtml from "sanitize-html";
import { configSafeDescription } from "@/utils/sanitizeHTML";
import {type ArticleBlog} from "@/types/types";
interface Props {
  articles: ArticleBlog[];
  text: {
    SECTION_LABEL: string;
    SECTION_TITLE: string;
    DESCRIPTION_ARTICLE: string;
    READ_MORE: string;
    NO_ARTICLES: string;
    FEATURED_LABEL: string;
  };
}

const { articles, text } = Astro.props;
const isEnglish = Astro.url.pathname.startsWith("/en");
const currentLocale = isEnglish ? "/en/" : "/";

const [featured, ...rest] = articles ?? [];

function sanitizeArticles() {
  if (!articles) return [];
  return rest.map((article) => ({
    ...article,
    DESCRIPTION: sanitizeHtml(article.DESCRIPTION, configSafeDescription)
  }));
}

const sanitizedFeatured = featured ? { ...featured, DESCRIPTION: sanitizeHtml(featured.DESCRIPTION, configSafeDescription) } : null;
const sanitizedArticles = sanitizeArticles();
---

<section
  id="articles"
  class="relative w-full py-14 sm:py-16  sm:px-2 lg:px-12 overflow-hidden  rounded-2xl bg-gradient-to-t from-transparent via-primary/10 to-transparent"
>

<!-- Encabezado de sección -->
<div class="articles-header max-w-5xl mx-auto mb-8 sm:mb-10 flex flex-col items-center text-center gap-5">

  <!-- Etiqueta -->
  <div class="flex items-center justify-center gap-3">
    <div class="w-10 h-0.5 bg-contrast"></div>
    <span class="text-sm tracking-[0.3em] uppercase text-primary font-bold">
      {text.SECTION_LABEL}
    </span>
    <div class="w-10 h-0.5 bg-contrast"></div>
  </div>

  <!-- Título -->
  <h2
    class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-black uppercase leading-none tracking-tight
           bg-gradient-to-r from-dark-primary to-primary
           bg-clip-text text-transparent"
  >
    {text.SECTION_TITLE}
  </h2>

  <!-- Descripción -->
  <p class="max-w-3xl text-lg sm:text-xl leading-8 text-gray-600">
    {text.DESCRIPTION_ARTICLE}
  </p>

</div>

  {
    !articles || articles.length === 0 ? (
      <p class="text-center text-slate-400 text-sm tracking-widest">{text.NO_ARTICLES}</p>
    ) : (
     <div class="max-w-[1600px] mx-auto flex flex-col gap-6 sm:gap-8">

        {sanitizedFeatured && (
          <article
            class="articles-item group relative flex flex-col lg:flex-row rounded-2xl overflow-hidden  transition-all duration-300 bg-cyan-600 backdrop-blur-xl shadow-md shadow-black/20 hover:shadow-lg hover:shadow-black/25"
          >
            <!-- Brillo superior sutil tipo glass -->
            <div class="absolute inset-0 bg-gradient-to-br from-white/[0.05] via-transparent to-transparent pointer-events-none"></div>

            {sanitizedFeatured.IMAGES?.[0] && (
              <div class="relative w-full lg:w-1/2 aspect-video lg:aspect-auto lg:min-h-[320px] overflow-hidden shrink-0">
                <img
                  src={sanitizedFeatured.IMAGES[0]}
                  alt={sanitizedFeatured.TITLE}
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                />
                <!-- Vignette interior sutil, no gradiente fuerte -->
                <div class="absolute inset-0 shadow-[inset_0_0_40px_rgba(0,0,0,0.25)] pointer-events-none"></div>
                <div class="absolute inset-0 bg-gradient-to-t from-dark-primary/35 via-transparent to-transparent lg:bg-gradient-to-r lg:from-transparent lg:to-dark-primary/30"></div>
                <div class="absolute top-3 left-3">
                  <span class="text-[10px] tracking-widest uppercase px-2.5 py-1 rounded-full bg-contrast text-white font-semibold shadow-sm">
                    ★ {text.FEATURED_LABEL}
                  </span>
                </div>
              </div>
            )}

            <div class="relative flex flex-col justify-between gap-4 p-6 sm:p-8 flex-1">

              <div class="flex flex-wrap items-center gap-2">
                {sanitizedFeatured.TAGS.map((tag) => (
                  <span class="article-tag text-[10px] sm:text-xs tracking-widest uppercase px-2.5 py-0.5 rounded-full bg-white/10 border border-white/15 text-cyan-200 font-semibold">
                    {tag}
                  </span>
                ))}
                <span class="ml-auto text-[11px] text-white/40 tabular-nums">{sanitizedFeatured.DATE}</span>
              </div>

              <h3 class="text-xl sm:text-2xl md:text-3xl font-bold leading-snug text-white group-hover:text-cyan-200 transition-colors duration-300">
                {sanitizedFeatured.TITLE}
              </h3>

              <div set:html={sanitizedFeatured.DESCRIPTION} class="text-sm sm:text-base text-white/60 leading-relaxed line-clamp-4">
              </div>

              {sanitizedFeatured.IMAGES.length > 1 && (
                <div class="flex gap-2 mt-1">
                  {sanitizedFeatured.IMAGES.slice(1, 4).map((img) => (
                    <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-lg overflow-hidden ring-1 ring-white/15 shrink-0">
                      <img src={img} alt="" class="w-full h-full object-cover" loading="lazy" />
                    </div>
                  ))}
                </div>
              )}

              <a
                href={`${currentLocale}articles/${sanitizedFeatured.LINK ?? sanitizedFeatured.ID}`}
                class="mt-auto pt-3 border-t border-white/10 self-start flex items-center gap-2 text-xs sm:text-sm font-semibold text-cyan-300 hover:text-white transition-colors duration-200"
              >
                {text.READ_MORE}
                <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </a>
            </div>
          </article>
        )}

        <!-- GRID DE ARTÍCULOS SECUNDARIOS -->
        {rest.length > 0 && (
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {sanitizedArticles.map((article:ArticleBlog, i: number) => (
              <article
                class="articles-item group relative flex flex-col rounded-2xl overflow-hidden  transition-all duration-300 bg-cyan-600 backdrop-blur-xl shadow-md shadow-black/20 hover:shadow-lg hover:shadow-black/25"
                style={`animation-delay: ${i * 80}ms;`}
              >
                <!-- Brillo superior sutil tipo glass -->
                <div class="absolute inset-0 bg-gradient-to-br from-white/[0.05] via-transparent to-transparent pointer-events-none z-10"></div>

                <!-- Imagen -->
                <div class="relative w-full aspect-[16/9] overflow-hidden">
                  {article.IMAGES?.[0] ? (
                    <img
                      src={article.IMAGES[0]}
                      alt={article.TITLE}
                      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                      loading="lazy"
                    />
                  ) : (
                    <div class="w-full h-full bg-white/5 flex items-center justify-center">
                      <svg class="w-8 h-8 text-white/20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                          d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                      </svg>
                    </div>
                  )}
                  <!-- Vignette interior sutil en vez de gradiente fuerte -->
                  <div class="absolute inset-0 shadow-[inset_0_0_30px_rgba(0,0,0,0.25)] pointer-events-none"></div>
                  <div class="absolute inset-0 bg-gradient-to-t from-dark-primary/40 via-transparent to-transparent"></div>
                  <!-- Badge encima de la imagen -->
                  <div class="absolute top-3 left-3 flex flex-wrap gap-1">
                    {article.TAGS.slice(0, 1).map((tag) => (
                      <span class="text-[9px] tracking-widest uppercase px-2 py-0.5 rounded-full bg-contrast text-white font-semibold shadow-sm">
                        {tag}
                      </span>
                    ))}
                  </div>
                </div>

                <!-- Contenido -->
                <div class="relative flex flex-col gap-3 p-5 flex-1">
                  <span class="text-[10px] text-white/40 tabular-nums">{article.DATE}</span>

                  <h3 class="text-base font-bold leading-snug text-white group-hover:text-cyan-200 transition-colors duration-300 line-clamp-2">
                    {article.TITLE}
                  </h3>

                  <div set:html={article.DESCRIPTION} class="text-xs text-white/55 leading-relaxed line-clamp-3 flex-1">
                  </div>

                  <div class="flex items-center justify-between mt-auto pt-3 border-t border-white/10">
                    <a
                      href={`${currentLocale}articles/${article.LINK ?? article.ID}`}
                      class="text-xs font-semibold text-cyan-300 hover:text-white flex items-center gap-1.5 transition-colors duration-200"
                    >
                      {text.READ_MORE}
                      <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                      </svg>
                    </a>

                    {article.IMAGES.length > 1 && (
                      <span class="text-[10px] text-white/40 flex items-center gap-1">
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                        </svg>
                        {article.IMAGES.length}
                      </span>
                    )}
                  </div>
                </div>

                <!-- Línea de acento inferior al hover -->
                <div class="absolute bottom-0 left-0 right-0 h-px opacity-0 group-hover:opacity-100 transition-opacity duration-500 bg-gradient-to-r from-transparent via-primary to-transparent"></div>
              </article>
            ))}
          </div>
        )}
      </div>
    )
  }
</section>

<style >
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .line-clamp-4 {
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  article {
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  article:hover {
    transform: translateY(-4px);
  }
</style>

<script>
  import("motion").then(({ animate, inView }) => {
    inView(".articles-header", (el) => {
      animate(
        el,
        { opacity: [0, 1], y: [-24, 0], filter: ["blur(8px)", "blur(0px)"] } as any,
        { duration: 0.7, ease: "easeOut" }
      );
    });

    document.querySelectorAll(".articles-item").forEach((el, i) => {
      inView(
        el,
        () => {
          animate(
            el,
            { opacity: [0, 1], y: [28, 0], filter: ["blur(6px)", "blur(0px)"] } as any,
            { duration: 0.65, delay: i * 0.1, ease: "easeOut" }
          );
        },
        { amount: 0.1 }
      );
    });
  });
</script>