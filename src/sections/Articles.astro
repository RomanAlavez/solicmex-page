---
import sanitizeHtml from "sanitize-html";
import { configSafeDescription } from "@/utils/sanitizeHTML";
import {type ArticleBlog} from "@/types/types";
interface Props {
  articles: ArticleBlog[];
  text: {
    SECTION_LABEL: string;   
    SECTION_TITLE: string;   
    READ_MORE: string;       
    NO_ARTICLES: string;     
  };
}

const { articles, text } = Astro.props;
const isEnglish = Astro.url.pathname.startsWith("/en");
const currentLocale = isEnglish ? "/en/" : "/";

const [featured, ...rest] = articles ?? [];


function sanitizeArticles() {
  if (!articles) return [];

  return rest.map((article) => ({
    ...article,
    DESCRIPTION: sanitizeHtml(article.DESCRIPTION, configSafeDescription)
  }));

}


const sanitizedFeatured = featured ? { ...featured, DESCRIPTION: sanitizeHtml(featured.DESCRIPTION, configSafeDescription) } : null;
const sanitizedArticles =  sanitizeArticles();
---

<section
  id="articles"
  class="relative w-full py-24 px-4 sm:px-8 overflow-hidden text-white"
>

  <!-- Fondo ambiental coherente con el layout -->
  <div class="absolute inset-0 -z-10 pointer-events-none">
    <div
      class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] rounded-full opacity-20"
      style="background: radial-gradient(ellipse, rgba(6,182,212,0.25) 0%, transparent 70%);"
    ></div>
    <div
      class="absolute bottom-0 right-0 w-[500px] h-[300px] rounded-full opacity-10"
      style="background: radial-gradient(ellipse, rgba(6,182,212,0.3) 0%, transparent 70%);"
    ></div>
    <!-- Línea horizontal decorativa superior -->
    <div
      class="absolute top-0 left-1/2 -translate-x-1/2 w-2/3 h-px"
      style="background: linear-gradient(to right, transparent, rgba(6,182,212,0.35), transparent);"
    ></div>
  </div>

  <!-- Encabezado de sección -->
  <div class="articles-header max-w-6xl mx-auto mb-12 sm:mb-16 flex flex-col gap-3">
    <div class="flex items-center gap-3">
      <div class="w-1.5 h-1.5 rounded-full bg-cyan-400 shadow-[0_0_8px_rgba(6,182,212,0.9)]"></div>
      <span class="text-xs sm:text-sm tracking-[0.25em] uppercase text-cyan-400/80 font-medium">
        {text.SECTION_LABEL}
      </span>
    </div>
    <h2
      class="text-3xl sm:text-4xl md:text-5xl font-extrabold uppercase tracking-tight"
      style="background: linear-gradient(135deg, #ffffff 30%, #67e8f9 70%, #0891b2 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;"
    >
      {text.SECTION_TITLE}
    </h2>
  </div>

  {
    !articles || articles.length === 0 ? (
      <p class="text-center text-white/40 text-sm tracking-widest">{text.NO_ARTICLES}</p>
    ) : (
      <div class="max-w-6xl mx-auto flex flex-col gap-6 sm:gap-8">


        {sanitizedFeatured && (
          <article
            class="articles-item group relative flex flex-col lg:flex-row rounded-2xl overflow-hidden border border-white/5 hover:border-cyan-400/25 transition-all duration-500"
            style="background: rgba(2, 18, 28, 0.5); backdrop-filter: blur(12px); box-shadow: 0 8px 40px rgba(0,0,0,0.35);"
          >

            {sanitizedFeatured.IMAGES?.[0] && (
              <div class="relative w-full lg:w-1/2 aspect-video lg:aspect-auto lg:min-h-[320px] overflow-hidden shrink-0">
                <img
                  src={sanitizedFeatured.IMAGES[0]}
                  alt={sanitizedFeatured.TITLE}
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                  loading="lazy"
                />

                <div class="absolute inset-0 lg:bg-gradient-to-r lg:from-transparent lg:to-[rgba(2,18,28,0.7)] bg-gradient-to-t from-[rgba(2,18,28,0.7)] to-transparent"></div>

                <div class="absolute top-3 left-3">
                  <span
                    class="text-[10px] tracking-[0.2em] uppercase font-semibold px-2.5 py-1 rounded-full"
                    style="background: rgba(6,182,212,0.18); border: 1px solid rgba(6,182,212,0.35); color: #67e8f9;"
                  >
                    ★ Destacado
                  </span>
                </div>
              </div>
            )}


            <div class="flex flex-col justify-between gap-4 p-6 sm:p-8 flex-1">

              <div class="flex flex-wrap items-center gap-2">
                {sanitizedFeatured.TAGS.map((tag) => (
                  <span class="article-tag text-[10px] sm:text-xs tracking-widest uppercase px-2.5 py-0.5 rounded-full text-cyan-300/80 border border-cyan-400/20"
                    style="background: rgba(6,182,212,0.07);">
                    {tag}
                  </span>
                ))}
                <span class="ml-auto text-[11px] text-white/35 tabular-nums">{sanitizedFeatured.DATE}</span>
              </div>


              <h3 class="text-xl sm:text-2xl md:text-3xl font-bold leading-snug text-white group-hover:text-cyan-100 transition-colors duration-300">
                {sanitizedFeatured.TITLE}
              </h3>


              <div set:html={sanitizedFeatured.DESCRIPTION} class="text-sm sm:text-base text-white/50 group-hover:text-white/70 leading-relaxed line-clamp-4 transition-colors duration-300">
              </div>


              {sanitizedFeatured.IMAGES.length > 1 && (
                <div class="flex gap-2 mt-1">
                  {sanitizedFeatured.IMAGES.slice(1, 4).map((img) => (
                    <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-lg overflow-hidden border border-white/10 shrink-0">
                      <img src={img} alt="" class="w-full h-full object-cover" loading="lazy" />
                    </div>
                  ))}
                </div>
              )}


              <a
                href={`${currentLocale}articles/${sanitizedFeatured.LINK ?? sanitizedFeatured.ID}`}
                class="group/btn self-start flex items-center gap-2 text-xs sm:text-sm font-medium text-cyan-300 hover:text-white border border-cyan-400/25 hover:border-cyan-300/60 rounded-xl px-4 py-2 transition-all duration-200"
                style="background: rgba(6,182,212,0.07);"
              >
                {text.READ_MORE}
                <svg class="w-3.5 h-3.5 group-hover/btn:translate-x-0.5 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </a>
            </div>
          </article>
        )}

        <!-- GRID DE ARTÍCULOS SECUNDARIOS -->
        {rest.length > 0 && (
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
            {sanitizedArticles.map((article:ArticleBlog, i: number) => (
              <article
                class="articles-item group relative flex flex-col rounded-2xl overflow-hidden border border-white/5 hover:border-cyan-400/20 transition-all duration-400 cursor-pointer"
                style={`background: rgba(2, 18, 28, 0.45); backdrop-filter: blur(10px); box-shadow: 0 4px 24px rgba(0,0,0,0.3); animation-delay: ${i * 80}ms;`}
              >
                <!-- Imagen -->
                {article.IMAGES?.[0] ? (
                  <div class="relative w-full aspect-video overflow-hidden">
                    <img
                      src={article.IMAGES[0]}
                      alt={article.TITLE}
                      class="w-full h-full object-cover transition-transform duration-600 group-hover:scale-105"
                      loading="lazy"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-[rgba(2,18,28,0.75)] via-transparent to-transparent"></div>
                  </div>
                ) : (
                  <!-- Placeholder sin imagen -->
                  <div
                    class="w-full aspect-video flex items-center justify-center"
                    style="background: linear-gradient(135deg, rgba(6,182,212,0.08), rgba(2,18,28,0.6));"
                  >
                    <svg class="w-8 h-8 text-cyan-400/20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 12h6m-6-4h2"/>
                    </svg>
                  </div>
                )}

                <!-- Contenido -->
                <div class="flex flex-col gap-3 p-4 sm:p-5 flex-1">
                  <!-- Tags + fecha -->
                  <div class="flex flex-wrap items-center gap-1.5">
                    {article.TAGS.slice(0, 2).map((tag) => (
                      <span class="text-[9px] tracking-widest uppercase px-2 py-0.5 rounded-full text-cyan-300/70 border border-cyan-400/15"
                        style="background: rgba(6,182,212,0.06);">
                        {tag}
                      </span>
                    ))}
                    <span class="ml-auto text-[10px] text-white/30 tabular-nums">{article.DATE}</span>
                  </div>

                  <!-- Título -->
                  <h3 class="text-sm sm:text-base font-semibold leading-snug text-white/90 group-hover:text-cyan-100 transition-colors duration-300 line-clamp-2">
                    {article.TITLE}
                  </h3>


                  <div set:html={article.DESCRIPTION} class="text-xs sm:text-sm text-white/40 group-hover:text-white/60 leading-relaxed line-clamp-3 transition-colors duration-300 flex-1">
                  </div>
                  <div class="flex items-center justify-between mt-auto pt-3 border-t border-white/5 group-hover:border-cyan-400/15 transition-colors duration-300">
                    <a
                      href={`${currentLocale}/articles/${article.LINK ?? article.ID}`}
                      class="text-[11px] sm:text-xs font-medium text-cyan-400/70 hover:text-cyan-200 flex items-center gap-1.5 transition-colors duration-200"
                    >
                      {text.READ_MORE}
                      <svg class="w-3 h-3 group-hover:translate-x-0.5 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                      </svg>
                    </a>

                    {article.IMAGES.length > 1 && (
                      <span class="text-[10px] text-white/25 flex items-center gap-1">
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                        </svg>
                        {article.IMAGES.length}
                      </span>
                    )}
                  </div>
                </div>


                <div
                  class="absolute bottom-0 left-0 right-0 h-px opacity-0 group-hover:opacity-100 transition-opacity duration-500"
                  style="background: linear-gradient(to right, transparent, rgba(6,182,212,0.6), transparent);"
                ></div>
              </article>
            ))}
          </div>
        )}
      </div>
    )
  }
</section>

<style is:global>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .line-clamp-4 {
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

<script>
  // Intersection Observer para animar al hacer scroll
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("in-view");
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.08 }
  );

  import("motion").then(({ animate, inView }) => {
    // Header de sección
    inView(".articles-header", (el) => {
      animate(
        el,
        { opacity: [0, 1], y: [-24, 0], filter: ["blur(8px)", "blur(0px)"] },
        { duration: 0.7, easing: "ease-out" }
      );
    });

    // Artículos (stagger)
    document.querySelectorAll(".articles-item").forEach((el, i) => {
      inView(
        el,
        () => {
          animate(
            el,
            { opacity: [0, 1], y: [28, 0], filter: ["blur(6px)", "blur(0px)"] },
            { duration: 0.65, delay: i * 0.1, easing: "ease-out" }
          );
        },
        { amount: 0.1 }
      );
    });
  });
</script>