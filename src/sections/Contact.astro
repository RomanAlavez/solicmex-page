---
import ContactItem from "@/components/ContactItem.astro";
import GeoIcon from "@/components/icons/GeoIcon.astro";
import PhoneIcon from "@/components/icons/PhoneIcon.astro";
import MailIcon from "@/components/icons/MailIcon.astro";

const { text } = Astro.props;
---

<section
  id="contact"
  class="relative w-full py-24 px-4 sm:px-8 overflow-hidden text-white"
>

  <!-- Fondo ambiental -->
  <div class="absolute inset-0 -z-10 pointer-events-none">
    <div
      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[500px] rounded-full opacity-10"
      style="background: radial-gradient(ellipse, rgba(6,182,212,0.35) 0%, transparent 70%);"
    ></div>
    <div
      class="absolute top-0 left-1/2 -translate-x-1/2 w-3/4 h-px"
      style="background: linear-gradient(to right, transparent, rgba(6,182,212,0.3), transparent);"
    ></div>
  </div>

  <div class="max-w-6xl mx-auto flex flex-col gap-14">

    <!-- Encabezado -->
    <div id="contact-header" class="flex flex-col gap-3 opacity-0">
      <div class="flex items-center gap-2.5">
        <div class="w-1.5 h-1.5 rounded-full bg-cyan-400 shadow-[0_0_8px_rgba(6,182,212,0.9)]"></div>
        <span class="text-xs tracking-[0.25em] uppercase text-cyan-400/80 font-medium">
          {text.LABEL ?? "Contacto"}
        </span>
      </div>
      <h2
        class="text-3xl sm:text-4xl md:text-5xl font-extrabold uppercase tracking-tight"
        style="background:linear-gradient(135deg,#ffffff 30%,#67e8f9 70%,#0891b2 100%); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text;"
      >
        {text.TITLE}
      </h2>
    </div>

    <!-- Cuerpo: info + formulario -->
    <div class="flex flex-col lg:flex-row gap-6 lg:gap-10 items-start w-full">

      <!-- ── Info de contacto ── -->
      <div id="contact-info" class="flex flex-col gap-5 w-full lg:w-5/12 opacity-0">

        <!-- Tarjeta de info -->
        <div
          class="flex flex-col gap-4 rounded-2xl p-6"
          style="background:rgba(2,14,22,0.5); border:1px solid rgba(6,182,212,0.1); backdrop-filter:blur(12px);"
        >
          <ContactItem text="operaciones@solicmex.com" link="mailto:operaciones@solicmex.com">
            <MailIcon />
          </ContactItem>

          <div class="w-full h-px" style="background:rgba(255,255,255,0.05);"></div>

          <ContactItem text="(552) 772 3862" link="tel:5527723862">
            <PhoneIcon />
          </ContactItem>

          <div class="w-full h-px" style="background:rgba(255,255,255,0.05);"></div>

          <ContactItem
            text="Calle Guanajuato 12, Col. Santiago, CP: 54667, Coyotepec, Estado de México"
            link="https://maps.app.goo.gl/aJXVixENdxUexKMZ7"
          >
            <GeoIcon />
          </ContactItem>
        </div>

        <!-- Nota de respuesta -->
        <p class="text-xs text-white/30 leading-relaxed px-1">
          {text.NOTE ?? "Respondemos en menos de 24 horas en días hábiles."}
        </p>
      </div>

      <!-- ── Formulario ── -->
      <form
        id="contact-form"
        class="flex flex-col gap-5 w-full lg:flex-1 rounded-2xl p-6 sm:p-8 opacity-0"
        style="background:rgba(2,14,22,0.5); border:1px solid rgba(6,182,212,0.1); backdrop-filter:blur(14px); box-shadow:0 8px 40px rgba(0,0,0,0.3);"
        action="https://formsubmit.co/operaciones@solicmex.com"
        method="POST"
      >
        <!-- Línea decorativa superior -->
        <div
          class="w-full h-px -mt-1 mb-1"
          style="background:linear-gradient(to right, rgba(6,182,212,0.4), transparent);"
        ></div>

        <h3 class="text-base sm:text-lg font-semibold text-white/85">
          {text.FORM_TITLE}
        </h3>

        <!-- Nombre -->
        <div class="flex flex-col gap-1.5">
          <label for="name" class="text-xs font-medium tracking-wide text-white/50 uppercase">
            {text.FORM_NAME}
          </label>
          <input
            type="text"
            id="name"
            name="nombre"
            class="form-field"
            required
          />
        </div>

        <!-- Email -->
        <div class="flex flex-col gap-1.5">
          <label for="email" class="text-xs font-medium tracking-wide text-white/50 uppercase">
            {text.FORM_EMAIL}
          </label>
          <input
            type="email"
            id="email"
            name="email"
            class="form-field"
            required
          />
        </div>

        <!-- Asunto -->
        <div class="flex flex-col gap-1.5">
          <label for="subject" class="text-xs font-medium tracking-wide text-white/50 uppercase">
            {text.FORM_SUBJECT}
          </label>
          <input
            type="text"
            id="subject"
            name="_subject"
            class="form-field"
            required
          />
        </div>

        <!-- Mensaje -->
        <div class="flex flex-col gap-1.5">
          <label for="message" class="text-xs font-medium tracking-wide text-white/50 uppercase">
            {text.FORM_MESSAGE}
          </label>
          <textarea
            id="message"
            name="mensaje"
            rows="4"
            class="form-field resize-none"
            required
          ></textarea>
        </div>

        <!-- Submit -->
        <button
          type="submit"
          class="group mt-2 flex items-center justify-center gap-2 rounded-xl w-full py-3 px-6 text-sm font-medium text-white transition-all duration-200"
          style="background:linear-gradient(135deg,rgba(6,182,212,0.28),rgba(8,145,178,0.18)); border:1px solid rgba(6,182,212,0.3); box-shadow:0 2px 16px rgba(6,182,212,0.12);"
          onmouseover="this.style.boxShadow='0 2px 28px rgba(6,182,212,0.3)'; this.style.borderColor='rgba(6,182,212,0.55)';"
          onmouseout="this.style.boxShadow='0 2px 16px rgba(6,182,212,0.12)'; this.style.borderColor='rgba(6,182,212,0.3)';"
        >
          {text.FORM_BUTTON}
          <svg
            class="w-4 h-4 group-hover:translate-x-0.5 transition-transform duration-200"
            fill="none" stroke="currentColor" viewBox="0 0 24 24"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
          </svg>
        </button>
      </form>

    </div>
  </div>
</section>

<style>
  /* Campos del formulario */
  .form-field {
    width: 100%;
    background: rgba(2, 18, 28, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 0.75rem;
    padding: 0.6rem 0.9rem;
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.85);
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  }

  .form-field::placeholder {
    color: rgba(255, 255, 255, 0.2);
  }

  .form-field:focus {
    border-color: rgba(6, 182, 212, 0.45);
    box-shadow: 0 0 0 3px rgba(6, 182, 212, 0.08);
    background: rgba(2, 22, 34, 0.7);
  }

  .form-field:hover:not(:focus) {
    border-color: rgba(255, 255, 255, 0.12);
  }
</style>

<script>
  import("motion").then(({ animate, inView }) => {
    inView(
      "#contact-header",
      (el) => animate(el,
        { opacity: [0, 1], y: [-20, 0], filter: ["blur(8px)", "blur(0px)"] },
        { duration: 0.7, easing: "ease-out" }
      ),
      { amount: 0.3 }
    );

    inView(
      "#contact-info",
      (el) => animate(el,
        { opacity: [0, 1], x: [-24, 0], filter: ["blur(6px)", "blur(0px)"] },
        { duration: 0.6, delay: 0.1, easing: "ease-out" }
      ),
      { amount: 0.2 }
    );

    inView(
      "#contact-form",
      (el) => animate(el,
        { opacity: [0, 1], x: [24, 0], filter: ["blur(6px)", "blur(0px)"] },
        { duration: 0.6, delay: 0.2, easing: "ease-out" }
      ),
      { amount: 0.2 }
    );
  });
</script>