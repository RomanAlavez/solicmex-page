---
import OverlayShape from "@/components/OverlayShape.astro";
import HeroCarousel from "@/components/hero-carousel";
import { ChevronRight } from "lucide-react";
import type { PrevService } from "@/types/types";

interface HeroProps {
  prevServices: PrevService[];
  title: string;
  subtitle: string;
  description: string;
  button: string;
}
const { prevServices, title, subtitle, description, button } = Astro.props as HeroProps;
---

<section id="hero" class="relative w-full h-[97%] overflow-hidden">
  <OverlayShape prevServices={prevServices} />

  <div
    id="hero-content"
    class="absolute inset-0 w-full h-full flex flex-row items-center gap-10 p-10"
  >
    <div id="hero-logo" class="flex flex-col items-center gap-4">
      <div class="relative group">
        <div
          class="absolute -inset-4 rounded-full border border-cyan-400/20 animate-spin-slow"
          style="animation: spin-slow 12s linear infinite;"
        >
        </div>
        <div
          class="absolute -inset-2 rounded-full border border-cyan-300/30"
          style="animation: pulse-ring 3s ease-in-out infinite;"
        >
        </div>
        <div
          class="relative size-28 sm:size-36 md:size-44 lg:size-52 rounded-full overflow-hidden border-2 border-cyan-400/50 shadow-[0_0_48px_rgba(6,182,212,0.35)] bg-primary/20 backdrop-blur-sm flex items-center justify-center"
        >
          <img
            src="/logo-solicmex.webp"
            alt="SolicMex Logo"
            class="w-full h-full object-contain p-1 sm:p-2"
            draggable="false"
          />
        </div>
      </div>
    </div>

    <div id="hero-text" class="flex flex-col text-left gap-4">
      <h1
        class="text-4xl md:text-7xl lg:text-9xl font-extrabold uppercase text-transparent bg-clip-text bg-gradient-to-r from-primary to-dark-primary text-shadow-lg"
      >
        {title}
      </h1>
      <p
        class="text-lg md:text-xl lg:text-2xl max-w-2xl bg-clip-text bg-gradient-to-r from-primary to-dark-primary text-shadow-lg"
      >
        {subtitle}
      </p>
      <span
        class="text-md md:text-lg lg:text-xl max-w-2xl font-normal text-gray-800/60"
      >
        {description}
      </span>
      <button
        class="w-fit inline-flex items-center gap-2 relative z-10 py-3 px-10 bg-primary/70 hover:bg-primary text-white font-medium rounded-xl cursor-pointer hover:shadow-lg transition-all duration-300"
      >
        {button}
        <ChevronRight />
      </button>
    </div>
  </div>

  <div class="absolute -z-10 w-full h-full mask-l-from-10% mask-l-to-50%">
    <div class="absolute inset-0 bg-gradient-to-t from-black to-transparent">
    </div>
    <HeroCarousel  client:load />
  </div>
</section>
