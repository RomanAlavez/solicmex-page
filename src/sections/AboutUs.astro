---

type Props = {
ABOUT_US: {
TITLE: string;
SUBTITLE: string;
DESCRIPTION_1: string;
DESCRIPTION_2: string;
DESCRIPTION_3: string;
DESCRIPTION_4: string;
DESCRIPTION_5: string;
CITE: string;
QUALITY_1: string;
QUALITY_2: string;
QUALITY_3: string;
QUALITY_4: string;
STADISTIC_1: string;
STADISTIC_2: string;
STADISTIC_3: string;
STADISTIC_4: string;
};
};

const { ABOUT_US } = Astro.props as Props;

const qualities = [
ABOUT_US.QUALITY_1,
ABOUT_US.QUALITY_2,
ABOUT_US.QUALITY_3,
ABOUT_US.QUALITY_4,
];

const stats = [
{ value: "10+", label: ABOUT_US.STADISTIC_1 },
{ value: "200+", label: ABOUT_US.STADISTIC_2 },
{ value: "150+", label: ABOUT_US.STADISTIC_3 },
{ value: "24/7", label: ABOUT_US.STADISTIC_4 },
];
---

<section
  id="about-us"
  class="relative overflow-hidden rounded-[2rem] bg-white py-20"
>
  <!-- Fondo decorativo -->
  <div class="absolute inset-0">
    <div
      class="absolute top-0 left-0 h-96 w-96 rounded-full bg-cyan-100 blur-3xl opacity-50"
    ></div>

```
<div
  class="absolute bottom-0 right-0 h-96 w-96 rounded-full bg-amber-100 blur-3xl opacity-50"
></div>
```

  </div>

  <div class="relative mx-auto max-w-7xl px-6 lg:px-10">

```
<div class="grid gap-14 lg:grid-cols-2 items-center">

  <!-- Información -->
  <div>



    <h2
      class="text-4xl md:text-5xl lg:text-6xl font-black text-slate-900 leading-tight mb-8"
    >
      {ABOUT_US.SUBTITLE.split(" ").slice(0, -1).join(" ")}

      <span class="block text-cyan-600">
        {ABOUT_US.SUBTITLE.split(" ").at(-1)}
      </span>
    </h2>

    <p
      class="text-lg leading-relaxed text-slate-700"
    >
      {ABOUT_US.DESCRIPTION_1}

      <span
        class="font-bold text-cyan-700"
      >
        {ABOUT_US.DESCRIPTION_2}
      </span>

      {ABOUT_US.DESCRIPTION_3}

      <span
        class="font-semibold text-slate-900"
      >
        {ABOUT_US.DESCRIPTION_4}
      </span>
    </p>

    <p
      class="mt-6 text-slate-600 leading-relaxed"
    >
      {ABOUT_US.DESCRIPTION_5}
    </p>

    <blockquote
      class="mt-8 border-l-4 border-amber-500 pl-5"
    >
      <p
        class="italic text-slate-600"
      >
        "{ABOUT_US.CITE}"
      </p>
    </blockquote>

    <div class="mt-10 grid grid-cols-2 gap-4">

      {
        qualities.map((quality) => (
          <div
            class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm transition-all duration-300 hover:border-cyan-300 hover:shadow-md"
          >
            <div class="flex items-center gap-3">

              <div
                class="flex h-9 w-9 items-center justify-center rounded-xl bg-cyan-100"
              >
                <svg
                  class="h-5 w-5 text-cyan-600"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"
                  />
                </svg>
              </div>

              <span
                class="text-sm font-medium text-slate-800"
              >
                {quality}
              </span>

            </div>
          </div>
        ))
      }

    </div>

  </div>

  <!-- Estadísticas -->
  <div>

    <div class="grid grid-cols-2 gap-5">

      {
        stats.map((stat, index) => (
          <div
            class={`rounded-3xl p-8 text-center shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lg ${
              index === 3
                ? "bg-cyan-600 text-white"
                : "bg-white border border-slate-200"
            }`}
          >
            <div
              class={`text-5xl font-black ${
                index === 3
                  ? "text-white"
                  : "text-cyan-600"
              }`}
            >
              {stat.value}
            </div>

            <div
              class={`mt-3 text-sm font-medium ${
                index === 3
                  ? "text-cyan-50"
                  : "text-slate-500"
              }`}
            >
              {stat.label}
            </div>
          </div>
        ))
      }

    </div>

  </div>

</div>
```

  </div>
</section>
