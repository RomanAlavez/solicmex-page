---
import ProjectCard from "@/components/ProjectCard";

const { projects, text, currentLocale } = Astro.props;
---

<section
  id="projects"
  class="relative w-full py-24 px-4 sm:px-8 overflow-hidden text-white"
>

  <!-- Fondo ambiental -->
  <div class="absolute inset-0 -z-10 pointer-events-none">
    <div
      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[500px] rounded-full opacity-10"
      style="background: radial-gradient(ellipse, rgba(6,182,212,0.3) 0%, transparent 70%);"
    ></div>
    <div
      class="absolute top-0 left-1/2 -translate-x-1/2 w-3/4 h-px"
      style="background: linear-gradient(to right, transparent, rgba(6,182,212,0.3), transparent);"
    ></div>
    <!-- Grid sutil -->
    <div
      class="absolute inset-0 opacity-[0.03]"
      style="background-image: linear-gradient(rgba(255,255,255,0.5) 1px, transparent 1px), linear-gradient(to right, rgba(255,255,255,0.5) 1px, transparent 1px); background-size: 40px 40px;"
    ></div>
  </div>

  <div class="max-w-6xl mx-auto flex flex-col gap-12">

    <!-- Encabezado -->
    <div id="projects-header" class="flex flex-col gap-3 opacity-0">
      <div class="flex items-center gap-2.5">
        <div class="w-1.5 h-1.5 rounded-full bg-cyan-400 shadow-[0_0_8px_rgba(6,182,212,0.9)]"></div>
        <span class="text-xs tracking-[0.25em] uppercase text-cyan-400/80 font-medium">
          {text.LABEL ?? "Proyectos"}
        </span>
      </div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold uppercase tracking-tight leading-tight">
        <span
          style="background:linear-gradient(135deg,#ffffff 30%,#67e8f9 70%,#0891b2 100%); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text;"
        >
          {text.TITLE}
        </span>
        {text.TITLE_SPAN && (
          <span
            style="background:linear-gradient(135deg,#fb923c,#f97316); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text;"
          >
            {" "}{text.TITLE_SPAN}
          </span>
        )}
      </h2>
    </div>

    <!-- Grid de proyectos -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-5 w-full">
      {projects?.map((project, i) => (
        <ProjectCard
          name={project.NAME}
          description={project.DESCRIPTION}
          images={project.IMAGES}
          ubication={project.UBICATION}
          app={project.APP}
          locale={currentLocale}
          index={i}
          client:load
        />
      ))}
    </div>

  </div>
</section>