---
import "@/styles/global.css";
import NavBar from "@/components/NavBar.astro";
import Footer from "@/sections/Footer.astro";
import { type Legal } from "@/types/types";
const { title, description, currentLanguage, nav, foot, legal } =
  Astro.props as {
    title: string;
    description: string;
    currentLanguage: string;
    nav: Record<string, string>;
    foot: Record<string, string>;
    legal: Legal;
  };
const GA_ID = import.meta.env.PUBLIC_GA_ID;
---

<!doctype html>
<html lang={currentLanguage}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/webp" href="/logo-fondo.webp" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}
    ></script>
  </head>

  <script define:vars={{ GA_ID }}>
    window.dataLayer = window.dataLayer || [];
    function gtag() {
      dataLayer.push(arguments);
    }
    gtag("js", new Date());

    gtag("config", GA_ID);
  </script>

  <body class="w-dvw min-h-dvh">
    <NavBar
      HOME={nav.HOME}
      SERVICES={nav.SERVICES}
      PROJECTS={nav.PROJECTS}
      GALLERY={nav.GALLERY}
      CLIENTS={nav.CLIENTS}
      ABOUT_US={nav.ABOUT_US}
      WHY_US={nav.WHY_US}
      OUR_PHILOSOPHY={nav.OUR_PHILOSOPHY}
      CONTACT={nav.CONTACT}
      ARTICLES={nav.ARTICLES}
      STORE={nav.STORE}
      LINK_STORE={nav.LINK_STORE}
    />
    <main class="w-full min-h-dvh pt-18 px-4 rounded-2xl">
      <slot />
    </main>

    <footer class="w-full px-4 rounded-2xl py-2 mb-2">

      <Footer
        DESCRIPTION={foot.DESCRIPTION}
        LINKS={foot.LINKS}
        LINK_ABOUT_US={foot.LINK_ABOUT_US}
        LINK_WHY_US={foot.LINK_WHY_US}
        LINK_SERVICES={foot.LINK_SERVICES}
        LINK_CONTACT={foot.LINK_CONTACT}
        CONTACT={foot.CONTACT}
        CERTIFICATIONS={foot.CERTIFICATIONS}
        CERTIFICATION_1={foot.CERTIFICATION_1}
        CERTIFICATION_2={foot.CERTIFICATION_2}
        CERTIFICATION_3={foot.CERTIFICATION_3}
        CERTIFICATION_4={foot.CERTIFICATION_4}
        COPYRIGHT={foot.COPYRIGHT}
        LEGAL={legal}
      />
    </footer>
  </body>
</html>
