---
import {
  AlarmSmoke,
  Wrench,
  ClipboardCheck,
  Package,
  DraftingCompass,
} from "lucide-react";
import type { PrevService } from "@/types/types";

const { prevServices } = Astro.props as {
  prevServices: PrevService[];
};

const ICONS = {
  DraftingCompass: DraftingCompass,
  Wrench: Wrench,
  ClipboardCheck: ClipboardCheck,
  Package: Package,
};
---

<div
  id="overlay-shape"
  class="absolute z-10 flex items-center justify-between p-2 sm:p-3 bg-linear-to-tr from-dark-primary to-primary bottom-0 w-full h-[12%] sm:h-[15%] md:h-1/5 shadow-[0_0_48px_rgba(6,182,212,0.35)] text-white"
>
  {
    prevServices.map((service) => {
      const Icon = ICONS[service.ICON as keyof typeof ICONS];

      return (
        <div class="group flex items-center py-1 px-1 sm:px-2 gap-1 sm:gap-2 min-w-0  transition-colors rounded-md">
          {Icon && (
            <Icon className="size-6 sm:size-8 md:size-10 shrink-0 p-1 sm:p-1.5 md:p-2 bg-dark-primary/50 shadow-2xl shadow-black/70 backdrop-blur-2xl rounded-md border border-white/10" />
          )}
          <span class="text-[10px] sm:text-xs md:text-sm lg:text-base font-medium truncate leading-tight  group-hover:bg-dark-primary/30 group-hover:p-2 rounded-md transition-all">
            {service.NAME}
          </span>
        </div>
      );
    })
  }
</div>