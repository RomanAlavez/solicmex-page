---
import ContactItem from "./ContactItem.astro";
import GeoIcon from "./GeoIcon.astro";
import PhoneIcon from "./PhoneIcon.astro";
import MailIcon from "./MailIcon.astro";

const { text } = Astro.props;
---

<section
  id="contact"
  class="flex flex-col min-h-screen items-center justify-center w-full gap-5 py-10 px-4 md:px-8 lg:gap-9"
>
  <h3 class="text-3xl md:text-4xl lg:text-6xl font-semibold text-white text-center">{text.TITLE}</h3>
  
  <div class="flex flex-col lg:flex-row w-full justify-between items-center max-w-6xl mt-5 gap-8 lg:gap-0">
    {/* Contact Info - Se muestra arriba en móviles */}
    <div class="flex flex-col gap-5 w-full lg:w-1/2 p-4 md:p-6 lg:p-10">
      <ContactItem
        text="operaciones@solicmex.com"
        link="mailto:operaciones@solicmex.com"><MailIcon /></ContactItem
      >
      <ContactItem
        text="contacto.icisi@gmail.com"
        link="mailto:contacto.icisi@gmail.com"><MailIcon /></ContactItem
      >
      <ContactItem text="(552) 772 3862" link="tel:(552) 772 3862"
        ><PhoneIcon /></ContactItem
      >
      <ContactItem text="(449) 735 2763" link="tel:(449) 735 2763"
        ><PhoneIcon /></ContactItem
      >
      <ContactItem
        text="Calle Guanajuato 12, Col.Santiago, CP: 54667, Coyotepec, Estado de México, México"
        link="https://maps.app.goo.gl/aJXVixENdxUexKMZ7"
        ><GeoIcon /></ContactItem
      >
    </div>

    {/* Form - Se muestra abajo en móviles */}
    <form
      class="border-white/10 border-t-0 border flex flex-col gap-5 w-full lg:w-1/2 p-6 md:p-8 h-auto rounded-lg text-white bg-gradient-to-t from-slate-950/50 to-transparent backdrop-blur-lg shadow-lg duration-200 transition-all"
      action="https://formsubmit.co/operaciones@solicmex.com"
      method="POST"
    >
      <h5 class="text-xl md:text-2xl font-semibold text-center mb-4">{text.FORM_TITLE}</h5>

      <div class="flex flex-col gap-2">
        <label for="name" class="text-sm font-medium">{text.FORM_NAME}</label>
        <input
          type="text"
          id="name"
          name="nombre"
          class="form-input bg-cyan-800/50 border border-white/10 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-white"
          required
        />
      </div>

      <div class="flex flex-col gap-2">
        <label for="email" class="text-sm font-medium">{text.FORM_EMAIL}</label>
        <input
          type="email"
          id="email"
          name="email"
          class="form-input bg-cyan-800/50 border border-white/10 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-white"
          required
        />
      </div>

      <div class="flex flex-col gap-2">
        <label for="subject" class="text-sm font-medium"
          >{text.FORM_SUBJECT}</label
        >
        <input
          type="text"
          name="_subject"
          id="subject"
          class="bg-cyan-800/50 border border-white/10 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-white"
          required
        />
      </div>

      <div class="flex flex-col gap-2">
        <label for="message" class="text-sm font-medium"
          >{text.FORM_MESSAGE}</label
        >
        <textarea
          id="message"
          name="mensaje"
          rows="4"
          class="form-textarea bg-cyan-800/50 border border-white/10 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-white"
          required></textarea>
      </div>

      <button
        type="submit"
        class="mt-4 rounded-2xl w-full h-auto bg-gradient-to-tr font-light text-white from-cyan-950/20 to-transparent hover:bg-black/20 backdrop-blur-md hover:shadow-sm hover:text-shadow-lg hover:text-shadow-white/50 py-2 px-5 text-sm cursor-pointer duration-150 transition-all"
      >
        {text.FORM_BUTTON}
      </button>
    </form>
  </div>
</section>