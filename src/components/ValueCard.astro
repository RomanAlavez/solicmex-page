---
interface Props {
  name: string;
  description: string;
  index?: number;
}

const { name, description, index = 0 } = Astro.props;

// Cycle through accent shades for visual variety
const accents = [
  "border-cyan-200/50 text-cyan-500",
  "border-cyan-200/50 text-cyan-500",
  "border-cyan-200/50 text-cyan-500",
  "border-white/30 text-white/90",
];
const accentClass = accents[index % accents.length];
---

<div
  class="group relative flex flex-col gap-2 p-5 rounded-xl bg-linear-to-tr from-orange-600 to-orange-600/90 border border-white/10 hover:bg-white/[0.07] hover:border-white/20 transition-all duration-300 cursor-default"
>
  <!-- Top accent line -->
  <div
    class={`absolute top-0 left-5 right-5 h-px  ${
      index % 2 === 0
        ? "bg-cyan-500"
        : "bg-red-400"
    } opacity-0 group-hover:opacity-100 transition-opacity duration-500`}
  >
  </div>

  <div class="flex items-center gap-3">
    <!-- Numbered index -->
    <span
      class={`text-xs font-black tracking-wider font-mono opacity-40 text-white`}
    >
      {String(index + 1).padStart(2, "0")}
    </span>
    <span class={`text-sm font-bold tracking-wide uppercase border-b pb-0.5  text-white ${accentClass}`}>
      {name}
    </span>
  </div>

  <p class="text-white/80 text-sm leading-relaxed pl-7">
    {description}
  </p>
</div>