---
const {title, value} = Astro.props;
---
<div class="text-center group hover:drop-shadow-md hover:text-shadow-2xs ease-out">
      <div class="text-4xl font-bold text-transparent bg-clip-text bg-gradient-to-tr from-white to-slate-400 group-hover:text-white duration-200 transition-all">{value}</div>
      <div class="group-hover:text-white  text-white/80 mt-2 duration-200 transition-all">{title}</div>
</div>