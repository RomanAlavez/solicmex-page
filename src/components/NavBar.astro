---
interface Props {
    // No props for now, but we can add some in the future if needed
    HOME: String;
    SERVICES: String;
    PROJECTS: String;
    GALLERY: String;
    CLIENTS: String;
    ABOUT_US: String;
    WHY_US: String;
    OUR_PHILOSOPHY: String;
    CONTACT: String;
    ARTICLES: String;
}

const {
    HOME,
    SERVICES,
    PROJECTS,
    GALLERY,
    CLIENTS,
    ABOUT_US,
    WHY_US,
    OUR_PHILOSOPHY,
    CONTACT,
    ARTICLES,
} = Astro.props as Props;
---

<nav
    id="navbar"
    class="fixed top-0 inset-x-0 z-50
    flex items-center justify-between
    px-6 py-3
    w-full
    bg-gradient-to-b
    from-[rgba(6,182,212,0.7)]
    to-[rgba(22,78,99,0.45)]
    backdrop-blur-xl
    border-b border-white/10
    shadow-[0_8px_32px_rgba(0,0,0,0.25)]
    transition-all duration-300"
>
    <!-- Logo -->
    <a href="/">
        <img
            src="/logo-solicmex.webp"
            alt="Logo"
            class="h-12
                transition-all duration-300
                hover:scale-110
                hover:drop-shadow-[0_0_12px_var(--color-dark-primary)]"
        />
    </a>

    <!-- Links -->
    <div class="flex items-center gap-6 md:gap-10">
        <a
            href="/"
            class="text-base md:text-xl font-bold text-white
                transition-all duration-300
                hover:text-[var(--color-contrast)]
                hover:drop-shadow-[0_0_10px_var(--color-contrast)]"
        >
            {HOME}
        </a>



        <a
            href="/"
            class="text-base md:text-xl font-bold text-white
                transition-all duration-300
                hover:text-[var(--color-contrast)]
                hover:drop-shadow-[0_0_10px_var(--color-contrast)]"
        >
            {SERVICES}
        </a>

<a
            href="/"
            class="text-base md:text-xl font-bold text-blue-400
                transition-all duration-300
                hover:text-[var(--color-contrast)]
                hover:drop-shadow-[0_0_10px_var(--color-contrast)]"
        >
            {PROJECTS}
        </a>


        <a
            href="/"
            class="text-base md:text-xl font-bold text-white
                transition-all duration-300
                hover:text-[var(--color-contrast)]
                hover:drop-shadow-[0_0_10px_var(--color-contrast)]"
        >
            {GALLERY}
        </a>

        <a
            href="/"
            class="text-base md:text-xl font-bold text-white
                transition-all duration-300
                hover:text-[var(--color-contrast)]
                hover:drop-shadow-[0_0_10px_var(--color-contrast)]"
        >
            {CLIENTS}
        </a>

        <a
            href="/about"
            class="text-base md:text-xl font-bold text-white
                transition-all duration-300
                hover:text-[var(--color-contrast)]
                hover:drop-shadow-[0_0_10px_var(--color-contrast)]"
        >
            {ABOUT_US}
        </a>

        <a
            href="/contact"
            class="text-base md:text-xl font-thin text-white
                transition-all duration-300
                hover:text-[var(--color-contrast)]
                hover:drop-shadow-[0_0_10px_var(--color-contrast)]"
        >
            {WHY_US}
        </a>

        <a
            href="/"
            class="text-base md:text-xl font-bold text-white
                transition-all duration-300
                hover:text-[var(--color-contrast)]
                hover:drop-shadow-[0_0_10px_var(--color-contrast)]"
        >
            {OUR_PHILOSOPHY}
        </a>


        <a
            href="/"
            class="text-base md:text-xl font-bold text-white
                transition-all duration-300
                hover:text-[var(--color-contrast)]
                hover:drop-shadow-[0_0_10px_var(--color-contrast)]"
        >
            {CONTACT}
        </a>


<a
            href="/"
            class="text-base md:text-xl font-bold text-white
                transition-all duration-300
                hover:text-[var(--color-contrast)]
                hover:drop-shadow-[0_0_10px_var(--color-contrast)]"
        >
            {ARTICLES}
        </a>


        <!-- Idioma -->
        <button
            type="button"
            aria-label="Cambiar idioma"
            title="Cambiar idioma"
            class="text-white
            transition-all duration-300
            hover:text-[var(--color-contrast)]
            hover:drop-shadow-[0_0_10px_var(--color-contrast)]"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="w-7 h-7"
            >
                <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                <path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0"></path>
                <path d="M3.6 9h16.8"></path>
                <path d="M3.6 15h16.8"></path>
                <path d="M11.5 3a17 17 0 0 0 0 18"></path>
                <path d="M12.5 3a17 17 0 0 1 0 18"></path>
            </svg>
        </button>
    </div>
</nav>

<style>
    :global(#navbar) {
        transition: all 0.4s ease;
    }

    :global(#navbar[data-scrolled]) {
        width: 95% !important;
        max-width: 72rem !important;
        left: 50% !important;
        right: auto !important;
        transform: translateX(-50%) !important;
        margin-top: 1rem !important;
        border-radius: 1rem !important;
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.4) !important;
    }
</style>

<script is:inline>
    const navbar = document.getElementById("navbar");

    window.addEventListener("scroll", () => {
        navbar?.toggleAttribute("data-scrolled", window.scrollY > 20);
    });
</script>
