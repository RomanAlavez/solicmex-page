---
interface Props {
    HOME: String;
    SERVICES: String;
    PROJECTS: String;
    GALLERY: String;
    CLIENTS: String;
    ABOUT_US: String;
    WHY_US: String;
    OUR_PHILOSOPHY: String;
    CONTACT: String;
    ARTICLES: String;
}

const {
    HOME, SERVICES, PROJECTS, GALLERY, CLIENTS,
    ABOUT_US, WHY_US, OUR_PHILOSOPHY, CONTACT, ARTICLES,
} = Astro.props;

const currentPath = Astro.url.pathname;
const isEnglish = currentPath.startsWith("/en");

import LanguageSwitcher from "@/components/LanguageSwitcher.astro";
import MobileNav from "@/components/MobileNav.astro";
import NavLinks from "@/components/NavLinks.astro";
---

<nav
    id="navbar"
    class="fixed top-0 inset-x-0 z-50
    grid grid-cols-[auto_1fr_auto]
    items-center
    px-6 py-3
    w-full
    bg-white
    border-b border-[rgba(6,182,212,0.2)]
    shadow-[0_2px_12px_rgba(6,182,212,0.08)]
    backdrop-blur-xl"
>
    <a href={isEnglish ? "/en" : "/"} class="flex-shrink-0">
        <img
            src="/logo-solicmex.webp"
            alt="Logo"
            class="h-14
                transition-all duration-300
                hover:scale-110
                hover:drop-shadow-[0_0_12px_var(--color-primary)]"
        />
    </a>

    <div class="hidden lg:flex items-center justify-center gap-2 xl:gap-4">
        <NavLinks
            variant="desktop"
            HOME={HOME}
            SERVICES={SERVICES}
            PROJECTS={PROJECTS}
            GALLERY={GALLERY}
            CLIENTS={CLIENTS}
            ABOUT_US={ABOUT_US}
            WHY_US={WHY_US}
            OUR_PHILOSOPHY={OUR_PHILOSOPHY}
            CONTACT={CONTACT}
            ARTICLES={ARTICLES}
        />
    </div>

    <div class="flex items-center justify-end gap-3">
        <LanguageSwitcher />

        <button
            id="menu-toggle"
            type="button"
            aria-label="Abrir menú"
            aria-expanded="false"
            class="lg:hidden flex flex-col gap-1.5 p-1
                text-dark-primary
                transition-all duration-300
                hover:text-contrast"
        >
            <span class="block w-6 h-0.5 bg-current transition-all duration-300"></span>
            <span class="block w-6 h-0.5 bg-current transition-all duration-300"></span>
            <span class="block w-6 h-0.5 bg-current transition-all duration-300"></span>
        </button>
    </div>
    
    <MobileNav
    HOME={HOME}
    SERVICES={SERVICES}
    PROJECTS={PROJECTS}
    GALLERY={GALLERY}
    CLIENTS={CLIENTS}
    ABOUT_US={ABOUT_US}
    WHY_US={WHY_US}
    OUR_PHILOSOPHY={OUR_PHILOSOPHY}
    CONTACT={CONTACT}
    ARTICLES={ARTICLES}
/>
</nav>



<style>
    :global(#navbar) {
        top: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 100%;
        transition:
            top 0.4s cubic-bezier(0.4, 0, 0.2, 1),
            border-radius 0.4s cubic-bezier(0.4, 0, 0.2, 1),
            box-shadow 0.4s cubic-bezier(0.4, 0, 0.2, 1),
            width 0.45s cubic-bezier(0.4, 0, 0.2, 1);
        will-change: top, width;
    }
    :global(#navbar[data-scrolled]) {
        top: 1rem !important;
        width: min(1400px, 88%) !important;
        border-radius: 1rem !important;
        border: 1px solid rgba(255, 255, 255, 0.15) !important;
        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.15) !important;
        backdrop-filter: blur(12px) !important;
    }

    :global(#navbar[data-scrolled] ~ #mobile-menu) {
        top: calc(1rem + 57px);
        width: min(1400px, 88%) !important;
        border-radius: 0 0 1rem 1rem !important;
    }
</style>

<script is:inline>
    const navbar = document.getElementById("navbar");
    const menuToggle = document.getElementById("menu-toggle");
    const mobileMenu = document.getElementById("mobile-menu");

   

    window.addEventListener("scroll", () => {
        const shouldFloat = window.scrollY > 20;
        navbar?.toggleAttribute("data-scrolled", shouldFloat);

        
    }, { passive: true });

    menuToggle?.addEventListener("click", () => {
        const isOpen = mobileMenu?.classList.toggle("hidden") === false;
        mobileMenu?.classList.toggle("flex", isOpen);
        menuToggle.setAttribute("aria-expanded", String(isOpen));
    });

    mobileMenu?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
            mobileMenu.classList.add("hidden");
            mobileMenu.classList.remove("flex");
            menuToggle?.setAttribute("aria-expanded", "false");
        });
    });
</script>