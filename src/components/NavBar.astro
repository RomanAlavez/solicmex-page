---
interface Props {
    // No props for now, but we can add some in the future if needed
    HOME: String;
    SERVICES: String;
    PROJECTS: String;
    GALLERY: String;
    CLIENTS: String;
    ABOUT_US: String;
    WHY_US: String;
    OUR_PHILOSOPHY: String;
    CONTACT: String;
    ARTICLES: String;
}

const {
    HOME,
    SERVICES,
    PROJECTS,
    GALLERY,
    CLIENTS,
    ABOUT_US,
    WHY_US,
    OUR_PHILOSOPHY,
    CONTACT,
    ARTICLES,
} = Astro.props as Props;
---

<nav
    id="navbar"
    class="fixed top-0 inset-x-0 z-50
    grid grid-cols-[auto_1fr_auto]
    items-center
    px-6 py-3
    w-full
    bg-white
    border-b border-[rgba(6,182,212,0.2)]
    shadow-[0_2px_12px_rgba(6,182,212,0.08)]
    backdrop-blur-xl"
>
    <a href="/" class="flex-shrink-0">
        <img
            src="/logo-solicmex.webp"
            alt="Logo"
            class="h-14
                transition-all duration-300
                hover:scale-110
                hover:drop-shadow-[0_0_12px_var(--color-dark-primary)]"
        />
    </a>

    <div class="hidden lg:flex items-center justify-center gap-2 xl:gap-4">
        <a
            href="/"
            class="nav-link-text text-lg font-medium text-[var(--color-dark-primary)] whitespace-nowrap transition-all duration-300 hover:text-[var(--color-contrast)]"
            >{HOME}</a
        >
        <a
            href="/"
            class="nav-link-text text-lg font-medium text-[var(--color-dark-primary)] whitespace-nowrap transition-all duration-300 hover:text-[var(--color-contrast)]"
            >{SERVICES}</a
        >
        <a
            href="/"
            class="nav-link-text text-lg font-medium text-[var(--color-dark-primary)] whitespace-nowrap transition-all duration-300 hover:text-[var(--color-contrast)]"
            >{PROJECTS}</a
        >
        <a
            href="/gallery"
            class="nav-link-text text-lg font-medium text-[var(--color-dark-primary)] whitespace-nowrap transition-all duration-300 hover:text-[var(--color-contrast)]"
            >{GALLERY}</a
        >
        <a
            href="/"
            class="nav-link-text text-lg font-medium text-[var(--color-dark-primary)] whitespace-nowrap transition-all duration-300 hover:text-[var(--color-contrast)]"
            >{CLIENTS}</a
        >
        <a
            href="/about"
            class="nav-link-text text-lg font-medium text-[var(--color-dark-primary)] whitespace-nowrap transition-all duration-300 hover:text-[var(--color-contrast)]"
            >{ABOUT_US}</a
        >
        <a
            href="/contact"
            class="nav-link-text text-lg font-medium text-[var(--color-dark-primary)] whitespace-nowrap transition-all duration-300 hover:text-[var(--color-contrast)]"
            >{WHY_US}</a
        >
        <a
            href="/"
            class="nav-link-text text-lg font-medium text-[var(--color-dark-primary)] whitespace-nowrap transition-all duration-300 hover:text-[var(--color-contrast)]"
            >{OUR_PHILOSOPHY}</a
        >
        <a
            href="/"
            class="nav-link-text text-lg font-medium text-[var(--color-dark-primary)] whitespace-nowrap transition-all duration-300 hover:text-[var(--color-contrast)]"
            >{CONTACT}</a
        >
        <a
            href="/"
            class="nav-link-text text-lg font-medium text-[var(--color-dark-primary)] whitespace-nowrap transition-all duration-300 hover:text-[var(--color-contrast)]"
            >{ARTICLES}</a
        >
    </div>

    <div class="flex items-center justify-end gap-3">
        <button
            type="button"
            aria-label="Cambiar idioma"
            title="Cambiar idioma"
            class="lang-btn text-[var(--color-dark-primary)] whitespace-nowrap transition-all duration-300 hover:text-[var(--color-contrast)]"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="w-7 h-7"
            >
                <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                <path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0"></path>
                <path d="M3.6 9h16.8"></path>
                <path d="M3.6 15h16.8"></path>
                <path d="M11.5 3a17 17 0 0 0 0 18"></path>
                <path d="M12.5 3a17 17 0 0 1 0 18"></path>
            </svg>
        </button>

        <button
            id="menu-toggle"
            type="button"
            aria-label="Abrir menú"
            aria-expanded="false"
            class="lg:hidden flex flex-col gap-1.5 p-1
                text-[var(--color-dark-primary)]
                transition-all duration-300
                hover:text-[var(--color-contrast)]"
        >
            <span class="block w-6 h-0.5 bg-current transition-all duration-300"
            ></span>
            <span class="block w-6 h-0.5 bg-current transition-all duration-300"
            ></span>
            <span class="block w-6 h-0.5 bg-current transition-all duration-300"
            ></span>
        </button>
    </div>
</nav>

<div
    id="mobile-menu"
    class="fixed top-[57px] inset-x-0 z-40
        hidden flex-col
        bg-gradient-to-b from-[rgba(6,182,212,0.95)] to-[rgba(22,78,99,0.9)]
        backdrop-blur-xl
        border-b border-white/10
        shadow-[0_8px_32px_rgba(0,0,0,0.25)]
        lg:hidden
        transition-all duration-300"
>
    <div class="flex flex-col px-6 py-4 gap-1">
        <a
            href="/"
            class="text-lg font-medium text-white py-3 border-b border-white/10 transition-all duration-300 hover:text-[var(--color-contrast)]"
            >{HOME}</a
        >
        <a
            href="/"
            class="text-lg font-medium text-white py-3 border-b border-white/10 transition-all duration-300 hover:text-[var(--color-contrast)]"
            >{SERVICES}</a
        >
        <a
            href="/"
            class="text-lg font-medium text-white py-3 border-b border-white/10 transition-all duration-300 hover:text-[var(--color-contrast)]"
            >{PROJECTS}</a
        >
        <a
            href="/gallery"
            class="text-lg font-medium text-white py-3 border-b border-white/10 transition-all duration-300 hover:text-[var(--color-contrast)]"
            >{GALLERY}</a
        >
        <a
            href="/"
            class="text-lg font-medium text-white py-3 border-b border-white/10 transition-all duration-300 hover:text-[var(--color-contrast)]"
            >{CLIENTS}</a
        >
        <a
            href="/about"
            class="text-lg font-medium text-white py-3 border-b border-white/10 transition-all duration-300 hover:text-[var(--color-contrast)]"
            >{ABOUT_US}</a
        >
        <a
            href="/contact"
            class="text-lg font-medium text-white py-3 border-b border-white/10 transition-all duration-300 hover:text-[var(--color-contrast)]"
            >{WHY_US}</a
        >
        <a
            href="/"
            class="text-lg font-medium text-white py-3 border-b border-white/10 transition-all duration-300 hover:text-[var(--color-contrast)]"
            >{OUR_PHILOSOPHY}</a
        >
        <a
            href="/"
            class="text-lg font-medium text-white py-3 border-b border-white/10 transition-all duration-300 hover:text-[var(--color-contrast)]"
            >{CONTACT}</a
        >
        <a
            href="/"
            class="text-lg font-medium text-white py-3 transition-all duration-300 hover:text-[var(--color-contrast)]"
            >{ARTICLES}</a
        >
    </div>
</div>

<style>
    :global(#navbar) {
        top: 0;
        width: 100%;
        left: 0;

        transition:
            top 0.4s cubic-bezier(0.4, 0, 0.2, 1),
            border-radius 0.4s cubic-bezier(0.4, 0, 0.2, 1),
            box-shadow 0.4s cubic-bezier(0.4, 0, 0.2, 1),
            width 0.4s cubic-bezier(0.4, 0, 0.2, 1),
            left 0.4s cubic-bezier(0.4, 0, 0.2, 1),
            transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);

        will-change: top, border-radius, width, transform;
    }

    :global(#navbar[data-scrolled]) {
        top: 1rem !important;

        width: min(1400px, 88%) !important;

        left: 50% !important;
        transform: translateX(-50%);

        border-radius: 1rem !important;

        border: 1px solid rgba(255, 255, 255, 0.15) !important;

        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.15) !important;

        backdrop-filter: blur(12px) !important;
    }

    :global(#navbar[data-scrolled] + #mobile-menu) {
        top: calc(57px + 1rem);
    }
</style>

<script is:inline>
    const navbar = document.getElementById("navbar");
    const menuToggle = document.getElementById("menu-toggle");
    const mobileMenu = document.getElementById("mobile-menu");
    const langBtn = navbar?.querySelector(".lang-btn");

    const floatingClasses = [
        "bg-gradient-to-b",
        "from-[rgba(6,182,212,0.7)]",
        "to-[rgba(22,78,99,0.45)]",
    ];

    const fixedClasses = [
        "bg-white",
        "border-b",
        "border-[rgba(6,182,212,0.2)]",
        "shadow-[0_2px_12px_rgba(6,182,212,0.08)]",
    ];

    window.addEventListener(
        "scroll",
        () => {
            const shouldFloat = window.scrollY > 20;
            navbar?.toggleAttribute("data-scrolled", shouldFloat);

            const links = navbar?.querySelectorAll(".nav-link-text");

            if (shouldFloat) {
                navbar?.classList.remove(...fixedClasses);
                navbar?.classList.add(...floatingClasses);
                links?.forEach((l) => {
                    l.classList.remove("text-[var(--color-dark-primary)]");
                    l.classList.add("text-white");
                });
                langBtn?.classList.remove("text-[var(--color-dark-primary)]");
                langBtn?.classList.add("text-white");
                menuToggle?.classList.remove(
                    "text-[var(--color-dark-primary)]",
                );
                menuToggle?.classList.add("text-white");
            } else {
                navbar?.classList.remove(...floatingClasses);
                navbar?.classList.add(...fixedClasses);
                links?.forEach((l) => {
                    l.classList.remove("text-white");
                    l.classList.add("text-[var(--color-dark-primary)]");
                });
                langBtn?.classList.remove("text-white");
                langBtn?.classList.add("text-[var(--color-dark-primary)]");
                menuToggle?.classList.remove("text-white");
                menuToggle?.classList.add("text-[var(--color-dark-primary)]");
            }
        },
        { passive: true },
    );

    menuToggle?.addEventListener("click", () => {
        const isOpen = mobileMenu?.classList.toggle("hidden") === false;
        mobileMenu?.classList.toggle("flex", isOpen);
        menuToggle.setAttribute("aria-expanded", String(isOpen));
    });

    mobileMenu?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
            mobileMenu.classList.add("hidden");
            mobileMenu.classList.remove("flex");
            menuToggle?.setAttribute("aria-expanded", "false");
        });
    });
</script>
