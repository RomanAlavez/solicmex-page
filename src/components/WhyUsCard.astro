---
const { title } = Astro.props;


---
<div
  class="bg-tansparent p-8 rounded-sm border-l border-white/50 hover:border-white hover:bg-cyan-700/30 hover:shadow-lg transition-all duration-300"
>
  <div class="flex items-start gap-6">
    <div class="bg-cyan-800/50 p-3 rounded-lg border border-cyan-700/50 size-1/6">
      <span ><slot name="icon" class="text-white/80"/></span>
    </div>
    <div>
      <h5 class="text-xl font-bold text-white mb-3">{title}</h5>
      <slot />
    </div>
  </div>
</div>
