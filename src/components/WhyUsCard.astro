---
const { title } = Astro.props;
---

<div
  class="relative group bg-white p-6 sm:p-8 rounded-lg border-l border-cyan-100 hover:border-orange-100 shadow-xl shadow-black/15 hover:shadow-2xl transition-all duration-300"
>
  <span class="absolute top-0 right-0 bg-cyan-200/30 rounded-full size-1/3 blur-3xl z-0 group-hover:bg-orange-300/40"></span>
  <div class="flex flex-col sm:flex-row gap-4 sm:gap-6">
    <div class=" p-3 rounded-lg border group-hover:border-orange-500 bg-cyan-100/50 group-hover:bg-orange-100/50 w-14 h-14 sm:w-16 sm:h-16 shrink-0 flex items-center justify-center">
      <span><slot name="icon" class="w-full h-full" /></span>
    </div>
    <div class="flex-1">
      <h5 class="text-lg sm:text-xl font-bold text-transparent bg-clip-text bg-linear-to-r from-cyan-600 to-cyan-500 group-hover:from-orange-600 group-hover:to-orange-500 uppercase mb-2 sm:mb-3 transition-colors duration-200">{title}</h5>
      <div class="text-black leading-relaxed space-y-3 sm:space-y-4">
        <slot />
      </div>
    </div>
  </div>
</div>