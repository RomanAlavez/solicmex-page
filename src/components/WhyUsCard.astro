---
const { title } = Astro.props;
---

<div
  class="bg-transparent p-6 sm:p-8 rounded-sm border-l border-white/50 hover:border-white hover:bg-cyan-700/30 hover:shadow-lg transition-all duration-300"
>
  <div class="flex flex-col sm:flex-row gap-4 sm:gap-6">
    <div class="bg-cyan-800/50 p-3 rounded-lg border border-cyan-700/50 w-14 h-14 sm:w-16 sm:h-16 flex-shrink-0 flex items-center justify-center">
      <span><slot name="icon" class="text-white/80 w-full h-full" /></span>
    </div>
    <div class="flex-1">
      <h5 class="text-lg sm:text-xl font-bold text-white mb-2 sm:mb-3">{title}</h5>
      <div class="text-white/90 leading-relaxed space-y-3 sm:space-y-4">
        <slot />
      </div>
    </div>
  </div>
</div>