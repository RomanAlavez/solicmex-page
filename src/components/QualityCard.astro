---
const {text} = Astro.props;
---
<div
  class="group bg-gradient-to-tr from-cyan-950/50 to-transparent drop-shadow-md backdrop-blur-md p-6 rounded-xl border border-white/50 hover:border-white flex flex-col items-center"
>
  <div class="text-white/80 group-hover:text-white w-full h-20 flex justify-center items-center mb-3 drop-shadow-md"><slot/></div>
  <h3 class="text-white font-medium text-center">{text}</h3>
</div>
