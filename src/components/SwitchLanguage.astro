---
import GlobeIcon from "./GlobeIcon.astro";
---

<div class="relative inline-block group">
  <button class="p-2 flex items-center text-white rounded transition-colors">
    <GlobeIcon />
  </button>
  
  <div class="absolute right-0 hidden group-hover:block backdrop-blur-3xl bg-black/50 rounded-lg shadow-lg min-w-[120px] py-2 z-10">
    <a href="/"class="w-full px-4 py-2 text-left text-white cursor-pointer text-xs hover:font-bold">Español</a>
    <a href="en" class="w-full px-4 py-2 text-left text-white cursor-pointer text-xs hover:font-bold">English</a>
  </div>
</div>