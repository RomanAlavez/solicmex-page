---
import ArrowRightIcon from "./ArrowRightIcon.astro";
import Image21 from "../assets/images/projects/image-21.jpg";
import { Image } from "astro:assets";
const { text } = Astro.props;
---

<section
  class="relative w-full min-h-screen flex flex-col items-center justify-center text-white text-center px-4 sm:px-8 py-16 md:py-0"
  id="home"
>
  <h1
    id="hero-title"
    class="text-5xl xs:text-6xl sm:text-7xl md:text-8xl lg:text-9xl font-extrabold uppercase bg-clip-text text-transparent bg-gradient-to-r from-white to-cyan-200 opacity-0"
  >
    SolicMex
  </h1>
  <h2
    id="hero-subtitle"
    class="text-lg sm:text-xl md:text-2xl lg:text-3xl font-light mt-2 sm:mt-3 md:mt-4 opacity-0 max-w-4xl px-4"
  >
    {text.SUBTITLE}
  </h2>
  <div
    id="hero-content"
    class="flex flex-col md:flex-row gap-4 mt-6 sm:mt-8 p-2 items-center w-full max-w-4xl md:w-3/4 lg:w-1/2 opacity-0"
  >
    <p
      class="w-full md:w-8/12 text-pretty text-center md:text-left text-xs sm:text-sm md:text-base text-white/50 hover:text-white hover:text-shadow hover:text-shadow-white/30 hover:bg-black/20 hover:backdrop-blur-md p-3 sm:p-4 rounded-xl sm:rounded-2xl duration-300 transition-all"
    >
      {text.DESCRIPTION}
    </p>
    <a
      class="flex flex-row gap-2 items-center justify-center rounded-xl sm:rounded-2xl w-full sm:w-fit h-auto bg-gradient-to-tr font-light text-white from-cyan-950/20 to-transparent hover:bg-black/20 backdrop-blur-sm md:backdrop-blur-md hover:shadow-sm hover:text-shadow hover:text-shadow-white/50 py-2 px-4 sm:px-5 text-xs sm:text-sm md:text-base cursor-pointer duration-150 transition-all"
      href="#contact"
    >
      {text.BUTTON}
      <ArrowRightIcon class="w-3 h-3 sm:w-4 sm:h-4" />
    </a>
  </div>
  <div
    class="-z-10 absolute inset-0 w-screen max-h-screen overflow-hidden mask-b-from-20% mask-b-to-100%"
  >
    <div class="w-full h-full relative mask-t-from-40% mask-t-to-100%">
      <Image
        src={Image21}
        alt="Imagen de obra en construcción"
        class="object-cover w-full h-full translate-x-0 sm:translate-x-1/3 mask-l-from-20% mask-l-to-98%"
        sizes="(max-width: 640px) 100vw, 50vw"
      />
    </div>
  </div>
</section>

<!-- Animación Motion One -->
<script>
  import("motion").then(({ animate }) => {
    const options = (delay) => ({
      duration: 0.8,
      delay,
      easing: "ease-out",
    });

    animate(
      "#hero-title",
      { opacity: [0, 1], y: [-40, 0], filter: ["blur(8px)", "blur(0px)"] },
      options(0.1)
    );

    animate(
      "#hero-subtitle",
      { opacity: [0, 1], y: [-20, 0], filter: ["blur(6px)", "blur(0px)"] },
      options(0.4)
    );

    animate(
      "#hero-content",
      { opacity: [0, 1], y: [-20, 0], filter: ["blur(6px)", "blur(0px)"] },
      options(0.7)
    );
  });
</script>