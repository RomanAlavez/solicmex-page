---
import ArrowRightIcon from "./ArrowRightIcon.astro";
const { text } = Astro.props;
---

<section
  class="w-full min-h-screen flex flex-col items-center justify-center text-white text-center px-4 sm:px-8"
  id="home"
>
  <h1
    id="hero-title"
    class="text-7xl sm:text-7xl md:text-8xl lg:text-9xl font-extrabold uppercase bg-clip-text text-transparent bg-gradient-to-r from-white to-cyan-200 opacity-0"
  >
    SolicMex
  </h1>
  <h2
    id="hero-subtitle"
    class="text-xl sm:text-2xl md:text-3xl font-light mt-2 sm:mt-4 opacity-0"
  >
    {text.SUBTITLE}
  </h2>
  <div
    id="hero-content"
    class="flex flex-col md:flex-row gap-4 mt-8 p-2 items-center w-full md:w-3/4 lg:w-1/2 opacity-0"
  >
    <p
      class="w-full md:w-8/12 text-pretty text-center md:text-left text-sm sm:text-base text-white/50 hover:text-white hover:text-shadow-lg hover:text-shadow-white/30 hover:bg-black/20 hover:backdrop-blur-lg p-4 rounded-2xl duration-300 transition-all"
    >
      {text.DESCRIPTION}
    </p>
    <a
      class="flex flex-row gap-2 items-center justify-center rounded-2xl w-full sm:w-fit h-auto bg-gradient-to-tr font-light text-white from-cyan-950/20 to-transparent hover:bg-black/20 backdrop-blur-md hover:shadow-sm hover:text-shadow-lg hover:text-shadow-white/50 py-2 px-5 text-sm sm:text-base cursor-pointer duration-150 transition-all"
      href="#contact"
    >
      {text.BUTTON} <ArrowRightIcon />
    </a>
  </div>
</section>

<!-- Animación Motion One -->
<script>
  import("motion").then(({ animate }) => {
    const options = (delay) => ({
      duration: 0.8,
      delay,
      easing: "ease-out"
    });

    animate(
      "#hero-title",
      { opacity: [0, 1], y: [-40, 0], filter: ["blur(8px)", "blur(0px)"] },
      options(0.1)
    );

    animate(
      "#hero-subtitle",
      { opacity: [0, 1], y: [-20, 0], filter: ["blur(6px)", "blur(0px)"] },
      options(0.4)
    );

    animate(
      "#hero-content",
      { opacity: [0, 1], y: [-20, 0], filter: ["blur(6px)", "blur(0px)"] },
      options(0.7)
    );
  });
</script>

