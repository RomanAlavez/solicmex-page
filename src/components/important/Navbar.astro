---
import NavItem from "@/components/NavItem.astro";
import SwitchLanguage from "@/components/important/SwitchLanguage";
import logoSrc from "@/assets/images/logo-solicmex.webp";
import { Image } from "astro:assets";

const { text } = Astro.props;
const isEnglish = Astro.url.pathname.startsWith("/en");
const currentLocale = isEnglish ? "/en" : "/";
---

<nav
  class="py-4 px-4 md:px-8 w-full md:w-10/12 flex flex-row justify-between items-center drop-shadow-2xl rounded-2xl"
>
  <!-- Logo -->
  <a href={currentLocale}>
    <Image src={logoSrc} alt="Solicmex Logo" class="w-15 h-auto opacity-50 hover:opacity-100" />
  </a>

  <!-- Menú para desktop -->
  <div class="group hidden md:flex flex-row gap-4 items-center">
    <NavItem link={`${currentLocale}`} text={text.HOME} />
    <NavItem link={`${currentLocale}#about-us`} text={text.ABOUT_US} />
    <NavItem link={`${currentLocale}#services`} text={text.SERVICES} />
    <NavItem link={`${currentLocale}#projects`} text={text.PROJECTS} />
    <NavItem link={`${currentLocale}#clients`} text={text.CLIENTS} />
    <NavItem link={`${currentLocale}#why-us`} text={text.WHY_US} />
    <NavItem
      link={`${currentLocale}${isEnglish ? "/articles" : "articles"}`}
      text={text.ARTICLES}
    />
    <NavItem link={`${currentLocale}#contact`} text={text.CONTACT} />
  </div>

  <!-- Botón de menú para mobile -->
  <div class="md:hidden">
    <button id="menu-toggle" class="text-white focus:outline-none">
      <svg
        class="w-6 h-6"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </div>

  <!-- Menú móvil (oculto por defecto) -->
  <div
    id="mobile-menu"
    class="hidden absolute top-full left-0 right-0 bg-gray-800 backdrop-blur-md rounded-b-2xl p-4 flex flex-col items-center space-y-4"
  >
    <NavItem link={`${currentLocale}#home`} text={text.HOME} />
    <NavItem link={`${currentLocale}#about-us`} text={text.ABOUT_US} />
    <NavItem link={`${currentLocale}#services`} text={text.SERVICES} />
    <NavItem link={`${currentLocale}#projects`} text={text.PROJECTS} />
    <NavItem link={`${currentLocale}#clients`} text={text.CLIENTS} />
    <NavItem link={`${currentLocale}#why-us`} text={text.WHY_US} />
    <NavItem link={`${currentLocale}articles`} text={text.ARTICLES} />
    <NavItem link={`${currentLocale}#contact`} text={text.CONTACT} />
    <SwitchLanguage client:load />
  </div>

  <!-- SwitchLanguage solo visible en desktop -->
  <div class="hidden md:block">
    <SwitchLanguage client:load />
  </div>
</nav>

<script>
  // Script para manejar el menú móvil
  document
    .getElementById("menu-toggle")
    ?.addEventListener("click", function () {
      const menu = document.getElementById("mobile-menu");
      menu?.classList.toggle("hidden");
    });
</script>
