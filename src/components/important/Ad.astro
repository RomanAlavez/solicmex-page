---
interface Props {
  title: string;
  description: string;
  button?: {
    label: string;
    href: string;
  };
}

const { title, description, button } = Astro.props;
---

<article
  class="w-7/10 bg-white/5 hover:bg-black/10 backdrop-blur-sm border border-slate-300/10 p-6 rounded-2xl transition-colors"
  style="box-shadow: 0 8px 32px rgba(0,0,0,0.4), 0 0 0 1px rgba(255,255,255,0.03) inset;"
>
  <!-- Línea superior decorativa -->
  <div
    class="rounded-t-2xl w-full h-px"
    style="background: linear-gradient(to right, transparent, rgba(6,182,212,0.4), transparent);"
  >
  </div>

  <div class="flex flex-col gap-3 px-5 py-4">
    <!-- Label + título -->
    <div class="flex flex-col gap-1">
      <h3 class="text-sm font-semibold text-white/90 leading-snug">
        {title}
      </h3>
    </div>

    <!-- Separador -->
    <div class="w-full h-px" style="background: rgba(255,255,255,0.05);"></div>

    <!-- Descripción -->
    <p class="text-xs text-white/45 leading-relaxed">
      {description}
    </p>

    <!-- Botón -->
    {
      button && (
        <a
          href={button.href}
          class="group flex items-center justify-between gap-2 text-xs font-medium text-white/80 hover:text-white rounded-xl px-3.5 py-2 transition-colors duration-200"
          style="background: rgba(6,182,212,0.1); border: 1px solid rgba(6,182,212,0.18);"
        >
          {button.label}
          <svg
            class="w-3 h-3 text-cyan-400/60 group-hover:text-cyan-300 transition-colors duration-200"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 5l7 7-7 7"
            />
          </svg>
        </a>
      )
    }
  </div>
</article>
