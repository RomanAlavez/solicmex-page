---
import AlarmIcon from "@/components/icons/AlarmIcon.astro";
import FireIcon from "@/components/icons/FireIcon.astro";
import LightningIcon from "@/components/icons/LightningIcon.astro";
import EngineeringIcon from "@/components/icons/EngineeringIcon.astro";
const { name, description, icon } = Astro.props;
---
<div class="group justify-between flex flex-col rounded-lg bg-gradient-to-tr hover:bg-gradient-to-t from-slate-950  to-transparent backdrop-blur-md border-white/30 hover:border-white/100 hover:shadow-lg border-1 p-8 duration-200 transition-all">
    <div class="w-full border-b border-b-white/30 h-24 p-5 justify-center items-center flex opacity-50 group-hover:opacity-100">
        {icon==='AlarmIcon' && <AlarmIcon class="w-16 h-16 text-white" />}
        {icon==='FireIcon' && <FireIcon class="w-16 h-16 text-white" />}
        {icon==='LightningIcon' && <LightningIcon class="w-16 h-16 text-white" />}
        {icon==='EngineeringIcon' && <EngineeringIcon class="w-16 h-16 text-white" />}
    </div>
    <div class="flex flex-col items-start justify-start text-left mt-4">
        <h4 class="text-3xl font-bold text-white mb-4 ">{name}</h4>
        <p class="text-lg text-white/90 max-w-2xl ">{description}</p>
    </div>

</div>