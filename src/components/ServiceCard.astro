---
import AlarmIcon from "@/components/icons/AlarmIcon.astro";
import FireIcon from "@/components/icons/FireIcon.astro";
import LightningIcon from "@/components/icons/LightningIcon.astro";
import EngineeringIcon from "@/components/icons/EngineeringIcon.astro";

const { name, description, icon, index = 0 } = Astro.props;
---

<div
  class="service-card group"
  style={`--delay: ${index * 80}ms`}
>
  <div class="card-glow"></div>

  <div class="icon-wrap">
    <div class="icon-ring">
      {icon === 'AlarmIcon'       && <AlarmIcon       class="card-icon" />}
      {icon === 'FireIcon'        && <FireIcon         class="card-icon" />}
      {icon === 'LightningIcon'   && <LightningIcon    class="card-icon" />}
      {icon === 'EngineeringIcon' && <EngineeringIcon  class="card-icon" />}
    </div>
  </div>

  <div class="divider"></div>

  <div class="card-body">
    <h4 class="card-name">{name}</h4>
    <p class="card-desc">{description}</p>
  </div>

  <span class="corner-dot"></span>
</div>

<style>
  /* ── Card shell ── */
  .service-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 2rem 1.75rem;
    border-radius: 1.25rem;
    overflow: hidden;
    cursor: default;

    background: rgba(2, 18, 28, 0.48);
    border: 1px solid rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 4px 28px rgba(0, 0, 0, 0.35);

    opacity: 0;
    transform: translateY(24px);
    animation: fadeUp 0.55s cubic-bezier(0.22, 1, 0.36, 1) var(--delay, 0ms) forwards;

    transition:
      border-color 0.3s ease,
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  .service-card:hover {
    border-color: rgba(6, 182, 212, 0.25);
    transform: translateY(-4px);
    box-shadow:
      0 24px 48px rgba(0, 0, 0, 0.4),
      0 0 0 1px rgba(6, 182, 212, 0.08) inset;
  }

  @keyframes fadeUp {
    to { opacity: 1; transform: translateY(0); }
  }

  /* ── Glow ── */
  .card-glow {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(
      ellipse at 50% 0%,
      rgba(6, 182, 212, 0.12) 0%,
      transparent 70%
    );
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }
  .service-card:hover .card-glow { opacity: 1; }

  /* ── Icon area ── */
  .icon-wrap {
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }

  .icon-ring {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 0.875rem;
    background: rgba(6, 182, 212, 0.07);
    border: 1px solid rgba(6, 182, 212, 0.15);
    transition: background 0.3s ease, border-color 0.3s ease, transform 0.3s ease;
  }

  .service-card:hover .icon-ring {
    background: rgba(6, 182, 212, 0.15);
    border-color: rgba(6, 182, 212, 0.45);
    transform: scale(1.08) rotate(-3deg);
  }

  :global(.card-icon) {
    width: 1.75rem;
    height: 1.75rem;
    color: rgba(103, 232, 249, 0.6);
    transition: color 0.3s ease;
  }

  .service-card:hover :global(.card-icon) {
    color: rgba(103, 232, 249, 1);
  }

  /* ── Divider ── */
  .divider {
    height: 1px;
    background: linear-gradient(
      90deg,
      rgba(6, 182, 212, 0.2),
      rgba(6, 182, 212, 0.05) 60%,
      transparent
    );
    transition: background 0.3s ease;
  }

  .service-card:hover .divider {
    background: linear-gradient(
      90deg,
      rgba(6, 182, 212, 0.45),
      rgba(6, 182, 212, 0.1) 60%,
      transparent
    );
  }

  /* ── Text ── */
  .card-body {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    text-align: left;
  }

  .card-name {
    font-size: 1.05rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.9);
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .card-desc {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.4);
    line-height: 1.7;
    transition: color 0.3s ease;
  }

  .service-card:hover .card-desc {
    color: rgba(255, 255, 255, 0.65);
  }

  /* ── Corner dot ── */
  .corner-dot {
    position: absolute;
    top: 1.1rem;
    right: 1.1rem;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(6, 182, 212, 0.15);
    transition: background 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
  }

  .service-card:hover .corner-dot {
    background: rgba(6, 182, 212, 0.8);
    transform: scale(1.4);
    box-shadow: 0 0 8px rgba(6, 182, 212, 0.7);
  }
</style>