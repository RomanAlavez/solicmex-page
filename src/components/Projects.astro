---
import ProjectCard from "./ProjectCard";

const {projects, text, currentLocale} = Astro.props;
---

<section
  id="projects"
  class="relative min-h-screen flex flex-col items-center justify-center text-white py-12 px-4 sm:px-6 md:px-8 gap-6 md:gap-10 w-full"
>
  <div
    class="absolute bottom-0 left-0 right-0 top-0 bg-[linear-gradient(to_right,#4f4f4f2e_1px,transparent_1px),linear-gradient(to_bottom,#4f4f4f2e_1px,transparent_1px)] bg-[size:14px_24px] [mask-image:radial-gradient(ellipse_80%_50%_at_50%_0%,#000_70%,transparent_110%)]"
  ></div>

  <div class="w-full max-w-6xl flex flex-col items-center md:items-start">
    <h3 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl text-center md:text-left font-bold mb-6 md:mb-8 lg:mb-10">
      {text.TITLE} <span
        class="bg-gradient-to-r from-orange-100/90 to-orange-400 bg-clip-text text-transparent"
        >{text.TITLE_SPAN}</span>
    </h3>

    <div
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-2 gap-4 sm:gap-5 md:gap-6 w-full"
    >
      {
        projects?.map((project) => (
          <ProjectCard
            name={project.NAME}
            description={project.DESCRIPTION}
            images={project.IMAGES}
            ubication={project.UBICATION}
            app={project.APP}
            locale={currentLocale}
            client:load
          />
        ))
      }
    </div>
  </div>
</section>