---
import ProjectCard from "./ProjectCard";

const {projects,text} = Astro.props;


---

<section
  id="projects"
  class="relative min-h-screen flex flex-col md:flex-row lg:flex-row items-center justify-center text-white text-center p-8 gap-10"
>
  <div
    class="absolute bottom-0 left-0 right-0 top-0 bg-[linear-gradient(to_right,#4f4f4f2e_1px,transparent_1px),linear-gradient(to_bottom,#4f4f4f2e_1px,transparent_1px)] bg-[size:14px_24px] [mask-image:radial-gradient(ellipse_80%_50%_at_50%_0%,#000_70%,transparent_110%)]"
  >
  </div>
  <h3 class="text-7xl text-center md:text-left lg:text-left font-bold">
    {text.TITLE} <span
      class="bg-gradient-to-r from-orange-100/90 to-orange-400 bg-clip-text text-transparent"
      >{text.TITLE_SPAN}</span>
  </h3>

  <div
    class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-6 w-full max-w-6xl"
  >
    {
      projects?.map((project) => (
        <ProjectCard
          name={project.NAME}
          description={project.DESCRIPTION}
          images={project.IMAGES}
          ubication={project.UBICATION}
          app={project.APP}
          client:load
        />
      ))
    }
  </div>

</section>
