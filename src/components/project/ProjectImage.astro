---
import slugify from "../../utils/utils";
const { project,img,index } = Astro.props;
---

<figure
  key={index}
  class="group relative overflow-hidden rounded-xl aspect-[4/3] border border-slate-700/50 hover:shadow-2xl transition-all duration-300 shadow-lg"
>
  <img
    src={img}
    alt={`${project.NAME} - Imagen ${index + 1}`}
    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
    style={`view-transition-name: project-image-${slugify(project.NAME)}-${index}`}
    loading={index > 2 ? "lazy" : "eager"}
  />
  <div
    class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-4"
  >
    <span class="text-sm font-medium text-white/90">{project.NAME}</span>
  </div>
</figure>
