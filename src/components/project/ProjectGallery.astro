---
import CardImageIcon from "@/components/icons/CardImageIcon.astro";
import ProjectImage from "@/components/project/ProjectImage.astro";

const { project,currentLanguage } = Astro.props;
---

{project.IMAGES && project.IMAGES.length > 0 && (
  <section class="mb-6">
    <h2 class="text-xl font-semibold mb-6 text-cyan-400 flex items-center gap-2 uppercase">
      <CardImageIcon />
    {currentLanguage === 'en' ? 'Gallery' : 'Galería'}
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {project.IMAGES.map((img, index) => (
        <ProjectImage project={project} img={img} index={index} />
      ))}
    </div>
  </section>
)}
