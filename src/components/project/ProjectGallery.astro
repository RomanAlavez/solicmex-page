---
import CardImageIcon from "@/components/icons/CardImageIcon.astro";
import ProjectLightbox from "@/components/project/ProjectLightBox";

const { project, currentLanguage } = Astro.props;
---

{project.IMAGES && project.IMAGES.length > 0 && (
  <section class="flex flex-col gap-4">

    <div class="flex items-center gap-2.5">
      <div class="w-1 h-1 rounded-full bg-cyan-400/60"></div>
      <span class="text-[10px] tracking-[0.25em] uppercase text-white/30 flex items-center gap-1.5">
        <CardImageIcon class="w-3 h-3" />
        {currentLanguage === "en" ? "Gallery" : "Galería"}
        <span style="color:rgba(255,255,255,0.2);">({project.IMAGES.length})</span>
      </span>
    </div>

    <ProjectLightbox
      images={project.IMAGES}
      name={project.NAME}
      client:load
    />

  </section>
)}