---
import slugify from "@/utils/utils.js";
import InfoIcon from "@/components/icons/InfoIcon.astro";

const { project, currentLanguage } = Astro.props;
---

<section class="flex flex-col gap-4">

  <!-- Label de sección -->
  <div class="flex items-center gap-2.5">
    <div class="w-1 h-1 rounded-full bg-cyan-400/60"></div>
    <span class="text-[10px] tracking-[0.25em] uppercase text-white/30 flex items-center gap-1.5">
      <InfoIcon class="w-3 h-3" />
      {currentLanguage === "en" ? "Description" : "Descripción"}
    </span>
  </div>

  <!-- Texto -->
  <p
    class="text-sm sm:text-base leading-relaxed"
    style={`color:rgba(255,255,255,0.65); view-transition-name: project-description-${slugify(project.NAME)};`}
  >
    {project.DESCRIPTION}
  </p>

</section>