---
import slugify from "@/utils/utils.js";
import InfoIcon from "@/components/icons/InfoIcon.astro";

const { project,currentLanguage } = Astro.props;
---

<section class="mb-10">
  <h2 class="text-xl font-semibold mb-4 text-cyan-400 flex items-center gap-2 uppercase">
    <InfoIcon />
    {currentLanguage === 'en' ? 'Description' : 'Descripción'}
    
  </h2>
  <p
    class="text-lg leading-relaxed text-white/90"
    style={`view-transition-name: project-description-${slugify(project.NAME)}`}
  >
    {project.DESCRIPTION}
  </p>
</section>
