---
import EngineeringIcon from "@/components/icons/EngineeringIcon.astro";
const { project, currentLanguage } = Astro.props;

const details = [
  {
    key: currentLanguage === "en" ? "Location" : "Ubicación",
    value: project.UBICATION,
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>`,
  },
  {
    key: currentLanguage === "en" ? "Application" : "Aplicación",
    value: project.APP,
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>`,
  },
].filter((d) => d.value);
---

{details.length > 0 && (
  <section class="flex flex-col gap-4">

    <!-- Label de sección -->
    <div class="flex items-center gap-2.5">
      <div class="w-1 h-1 rounded-full bg-cyan-400/60"></div>
      <span class="text-[10px] tracking-[0.25em] uppercase text-white/30 flex items-center gap-1.5">
        <EngineeringIcon class="w-3 h-3" />
        {currentLanguage === "en" ? "Details" : "Detalles"}
      </span>
    </div>

    <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      {details.map((detail) => (
        <li
          class="group flex flex-col gap-1.5 rounded-xl p-4 border transition-all duration-300 hover:-translate-y-0.5"
          style="background:rgba(2,14,22,0.5); border-color:rgba(255,255,255,0.05); backdrop-filter:blur(10px);"
          onmouseover="this.style.borderColor='rgba(6,182,212,0.25)'; this.style.boxShadow='0 4px 20px rgba(0,0,0,0.2)';"
          onmouseout="this.style.borderColor='rgba(255,255,255,0.05)'; this.style.boxShadow='none';"
        >
          <strong class="text-[10px] tracking-[0.2em] uppercase flex items-center gap-1.5"
                  style="color:rgba(103,232,249,0.6);">
            <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                 set:html={detail.icon} />
            {detail.key}
          </strong>
          <span class="text-sm font-medium" style="color:rgba(255,255,255,0.85);">
            {detail.value}
          </span>
        </li>
      ))}
    </ul>

  </section>
)}