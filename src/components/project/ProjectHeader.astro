---
import slugify from "@/utils/utils.js";

const { project } = Astro.props;
---

<header class="p-8 text-white overflow-hidden relative">
  <div
    class="absolute inset-0 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-transparent via-cyan-500/10 to-transparent opacity-30"
  ></div>
  <div class="relative z-10">
    <div class="flex items-center gap-3 mb-3">
      <div class="h-1 w-8 bg-cyan-300 rounded-full"></div>
      <span class="text-sm font-medium tracking-wider text-cyan-100">{project.APP}</span>
    </div>
    <h1
      class="text-5xl sm:text-7xl font-bold mb-2 bg-clip-text text-transparent bg-gradient-to-r from-white to-cyan-300"
      style={`view-transition-name: project-name-${slugify(project.NAME)}`}
    >
      {project.NAME}
    </h1>
  </div>
</header>
