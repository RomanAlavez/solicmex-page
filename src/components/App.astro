---
import Hero from "@/sections/Hero.astro";
import Clients from "@/sections/Clients.astro";
import Layout from "@/layouts/Layout.astro";
import AboutUs from "@/sections/AboutUs.astro";
import Services from "@/sections/Services.astro";
import Projects from "@/sections/Projects.astro";
import Brands from "@/sections/Brands.astro";
import Contact from "@/sections/Contact.astro";
import WhyUs from "@/sections/WhyUs.astro";
import ArticlesPreview from "@/components/articles/ArticlesPreview.astro";
import { getI18N } from "@/i18n";

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });
---

<Layout
  currentLanguage={currentLocale}
  title={i18n.SEO_TITLE}
  description={i18n.SEO_DESCRIPTION}
  nav={i18n.NAV}
  foot={i18n.FOOTER}
>
  <main class="w-full flex flex-col">
    <Hero text={i18n.HERO} ad={i18n.AD} />
    <ArticlesPreview
      articles={i18n.ARTICLES.ARTICLES_LIST}
      max={3}
      articlesHref="articles"
      text={i18n.ARTICLES_PREVIEW}
    />
    <AboutUs text={i18n.ABOUT_US} />
    <Services text={i18n.SERVICES} services={i18n.SERVICES.SERVICES_LIST} />

    <Brands text={i18n.BRANDS} />
    <Projects
      text={i18n.PROJECTS}
      projects={i18n.PROJECTS.PROJECTS_LIST}
      currentLocale={currentLocale}
    />
    <Clients text={i18n.CLIENTS} />
    <WhyUs text={i18n.WHY_US} />
    <Contact text={i18n.CONTACT} />
  </main>
</Layout>
