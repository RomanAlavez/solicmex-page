---
import sanitizeHtml from "sanitize-html";
import type { ArticleBlog } from "@/types/types.d.ts";
import ArticleGallery from "@/components/ArticleGallery";
interface Props {
  article: ArticleBlog;
  backHref?: string;
  backLabel?: string;
}

const { article, backHref = "/", backLabel = "Volver" } = Astro.props;
const safeDescription = sanitizeHtml(article.DESCRIPTION, {
  allowedTags: sanitizeHtml.defaults.allowedTags.concat([
    "h1",
    "h2",
    "h3",
    "h4",
    "img",
  ]),
  allowedAttributes: {
    ...sanitizeHtml.defaults.allowedAttributes,
    img: ["src", "alt", "loading"],
    "*": ["class"],
  },
});
---

<article class="relative w-full overflow-hidden text-white bg-[#f8fbfd]">
  <!-- HERO -->
  <header
    class="relative w-full min-h-[60vh] flex items-end overflow-hidden rounded-3xl"
  >
    {
      article.IMAGES?.[0] ? (
        <img
          src={article.IMAGES[0]}
          alt={article.TITLE}
          class="absolute inset-0 w-full h-full object-cover scale-105"
          loading="eager"
        />
      ) : (
        <div class="absolute inset-0 bg-gradient-to-br from-black via-dark-primary to-primary/40" />
      )
    }

    <!-- Overlays -->
    <div
      class="absolute inset-0 bg-gradient-to-t from-dark-primary via-dark-primary/55 to-transparent"
    >
    </div>
    <div
      class="absolute inset-0 bg-gradient-to-r from-black/70 via-dark-primary/20 to-transparent"
    >
    </div>

    <!-- Línea de acento superior -->
    <div
      class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-contrast via-primary to-primary/20"
    >
    </div>

    <div
      class="hero-content relative z-10 w-full px-6 sm:px-12 lg:px-20 pb-14 pt-32 flex flex-col gap-4 max-w-5xl"
    >
      <!-- Volver -->
      <a
        href={backHref}
        class="group inline-flex w-fit self-start items-center gap-2 rounded-full border border-white/14 bg-white/6 px-4 py-2 text-xs font-medium text-white/88 backdrop-blur-md transition-all duration-300 hover:border-primary/50 hover:bg-primary/12 hover:text-white"
      >
        <svg
          class="w-3 h-3 group-hover:-translate-x-0.5 transition-transform duration-300"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2.5"
            d="M15 19l-7-7 7-7"></path>
        </svg>
        {backLabel}
      </a>

      <!-- Tags -->
      {
        article.TAGS?.length > 0 && (
          <div class="flex flex-wrap gap-2.5">
            {article.TAGS.slice(0, 4).map((tag) => (
              <span class="inline-flex items-center rounded-full border border-white/12 bg-white/6 px-3.5 py-1.5 text-[9px] font-semibold uppercase tracking-[0.24em] text-white/74 backdrop-blur-sm transition-colors duration-300 hover:border-primary/35 hover:bg-primary/10 hover:text-white/92">
                {tag}
              </span>
            ))}
          </div>
        )
      }

      <!-- Título -->
      <h1
        class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold uppercase leading-tight tracking-tight"
        style="background:linear-gradient(135deg,#ffffff 0%,#ffffff 35%,#67e8f9 65%,#06b6d4 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;"
      >
        {article.TITLE}
      </h1>

      <!-- Fecha + meta -->
      <div class="flex items-center gap-3 mt-1">
        <div
          class="w-2 h-2 rounded-full bg-contrast shadow-[0_0_15px_rgba(245,73,0,.9)]"
        >
        </div>
        <time class="text-xs tabular-nums text-white/85 font-mono">
          {article.DATE}
        </time>
        <span class="text-primary/30">·</span>
        <span
          class="text-[10px] font-mono text-white/40 uppercase tracking-widest"
        >
          {article.ID}
        </span>
      </div>
    </div>
  </header>

  <!-- CUERPO -->
  <div
    class="article-layout w-full px-6 sm:px-12 lg:px-20 pt-10 pb-20 flex flex-col gap-10 max-w-7xl mx-auto"
  >
    <!-- Contenido editorial -->
    <div
      class="prose-wrapper relative overflow-hidden rounded-3xl border border-transparent bg-white px-5 py-7 shadow-[0_24px_70px_rgba(15,23,42,.16)] sm:px-8 sm:py-10"
    >
      <div class="article-body" set:html={safeDescription} />
    </div>


    {
  article.IMAGES?.length > 1 && (
    <section class="flex flex-col gap-4">
      <span class="text-[10px] tracking-[0.22em] uppercase text-white/40">
        Galería ({article.IMAGES.length - 1})
      </span>
      <ArticleGallery
        images={article.IMAGES.slice(1)}
        name={article.TITLE}
        client:load
      />
    </section>
  )
}


    
    <!-- Separador final -->
    <div
      class="w-full h-px bg-gradient-to-r from-transparent via-primary/50 to-transparent"
    >
    </div>

    <!-- Footer -->
    <footer class="flex flex-wrap items-center justify-between gap-4">
      <div class="flex flex-wrap gap-2">
        {
          article.TAGS?.map((tag) => (
            <span class="inline-flex items-center rounded-full border border-slate-300/70 bg-white/95 px-3.5 py-1.5 text-[9px] font-semibold uppercase tracking-[0.24em] text-slate-700 shadow-sm backdrop-blur-sm transition-colors duration-300 hover:border-primary/35 hover:bg-primary/10 hover:text-slate-900">
              {tag}
            </span>
          ))
        }
      </div>

      <a
        href={backHref}
        class="group inline-flex w-fit items-center gap-2 rounded-full border border-white/14 bg-black/6 px-4 py-2 text-xs font-medium text-black/88 shadow-sm backdrop-blur-md transition-all duration-300 hover:border-primary/50 hover:bg-primary/12 hover:text-black sm:ml-10"
      >
        <svg
          class="w-3 h-3 group-hover:-translate-x-0.5 transition-transform duration-300"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2.5"
            d="M15 19l-7-7 7-7"></path>
        </svg>
        {backLabel}
      </a>
    </footer>
  </div>
</article>

<style>
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-content {
    animation: fadeUp 0.6s ease both;
  }
  .article-layout {
    animation: fadeUp 0.6s ease both;
    animation-delay: 0.2s;
  }

  /* Tipografía editorial */
  :global(.article-body) {
    color: rgba(15, 23, 42, 0.9);
    font-size: clamp(1.06rem, 0.92vw + 0.72rem, 1.14rem);
    line-height: 2;
    letter-spacing: 0.002em;
    max-width: 64rem;
    margin: 0;
    padding-inline: 0;
  }

  :global(.article-body > :first-child) {
    margin-top: 0;
  }

  :global(.article-body > :last-child) {
    margin-bottom: 0;
  }

  /* Drop cap */
  :global(.article-body > p:first-of-type::first-letter) {
    float: left;
    font-size: 4em;
    line-height: 0.78;
    font-weight: 900;
    color: #f54900;
    margin: 0.06em 0.14em 0 0;
  }
  :global(.article-body > p:first-of-type) {
    font-size: 1.16em;
    color: rgba(15, 23, 42, 0.84);
    text-align: left;
  }

  :global(.article-body p) {
    margin: 0 0 1.9rem;
    text-align: justify;
    text-wrap: pretty;
    hyphens: auto;
    color: rgba(15, 23, 42, 0.84);
  }

  /* Headings */
  :global(.article-body h1),
  :global(.article-body h2),
  :global(.article-body h3),
  :global(.article-body h4) {
    font-weight: 800;
    margin: 3.25rem 0 1rem;
    line-height: 1.2;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  :global(.article-body h1) {
    font-size: 2rem;
    color: #0f172a;
    padding-bottom: 0.7rem;
    border-bottom: 2px solid;
    border-image: linear-gradient(to right, #f54900, rgba(245, 73, 0, 0.35), transparent)
      1;
  }
  :global(.article-body h2) {
    font-size: 1.55rem;
    color: #0f172a;
    padding-bottom: 0.7rem;
    border-bottom: 1px solid rgba(15, 23, 42, 0.12);
  }
  :global(.article-body h3) {
    font-size: 1.2rem;
    color: #0f172a;
    padding-left: 1rem;
    border-left: 4px solid #f54900;
  }
  :global(.article-body h4) {
    font-size: 0.9rem;
    color: rgba(245, 73, 0, 0.98);
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }

  /* Inline */
  :global(.article-body strong) {
    font-weight: 900;
    color: #f54900;
  }
  :global(.article-body em) {
    font-style: italic;
    color: #0f172a;
  }
  :global(.article-body mark) {
    background: rgba(245, 73, 0, 0.12);
    color: #f54900;
    padding: 0.05em 0.3em;
    border-radius: 3px;
  }

  /* Links */
  :global(.article-body a) {
    color: #f54900;
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: rgba(245, 73, 0, 0.28);
    transition:
      color 0.15s,
      text-decoration-color 0.15s;
  }
  :global(.article-body a:hover) {
    color: #d9480f;
    text-decoration-color: rgba(245, 73, 0, 0.55);
  }

  /* Listas */
  :global(.article-body ul) {
    list-style: none;
    padding: 0 0 0 1.35rem;
    margin: 0 0 1.8rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  :global(.article-body ul > li) {
    position: relative;
    padding-left: 0.35rem;
  }
  :global(.article-body ul > li::before) {
    content: "▸";
    position: absolute;
    left: -1.5rem;
    color: #f54900;
    font-size: 0.85em;
    top: 0.15em;
    font-weight: 900;
  }
  :global(.article-body ol) {
    list-style: none;
    counter-reset: ol-counter;
    padding: 0 0 0 1.5rem;
    margin: 0 0 1.8rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  :global(.article-body ol > li) {
    position: relative;
    counter-increment: ol-counter;
    padding-left: 0.35rem;
  }
  :global(.article-body ol > li::before) {
    content: counter(ol-counter) ".";
    position: absolute;
    left: -2rem;
    color: #f54900;
    font-weight: 900;
    font-size: 0.9em;
    font-family: monospace;
  }

  /* Blockquote */
  :global(.article-body blockquote) {
    margin: 2.2rem 0;
    padding: 1.3rem 1.6rem;
    border-left: 4px solid #f54900;
    background: #fff7f1;
    border-radius: 0 16px 16px 0;
    font-style: italic;
    color: rgba(15, 23, 42, 0.8);
    font-size: 1.05em;
  }

  /* Code */
  :global(.article-body code) {
    font-family: ui-monospace, monospace;
    font-size: 0.82em;
    color: #0f172a;
    background: #f8fafc;
    border: 1px solid rgba(15, 23, 42, 0.12);
    padding: 0.12em 0.45em;
    border-radius: 5px;
  }

  /* HR */
  :global(.article-body hr) {
    border: none;
    height: 1px;
    background: linear-gradient(
      to right,
      #f54900,
      rgba(15, 23, 42, 0.16),
      transparent
    );
    margin: 2.5rem 0;
  }

  /* Imágenes */
  :global(.article-body img) {
    width: 100%;
    border-radius: 16px;
    margin: 2rem 0;
    border: 1px solid rgba(15, 23, 42, 0.08);
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.12);
  }

  /* Tablas */
  :global(.article-body table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
    margin: 1.8rem 0;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgba(15, 23, 42, 0.08);
  }
  :global(.article-body th) {
    background: rgba(245, 73, 0, 0.08);
    color: #0f172a;
    font-weight: 700;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.6rem 1rem;
    text-align: left;
  }
  :global(.article-body td) {
    padding: 0.5rem 1rem;
    border-bottom: 1px solid rgba(15, 23, 42, 0.06);
    color: rgba(15, 23, 42, 0.8);
  }
  :global(.article-body tr:last-child td) {
    border-bottom: none;
  }
  :global(.article-body tr:hover td) {
    background: rgba(15, 23, 42, 0.03);
  }
</style>
