---
import sanitizeHtml from "sanitize-html";
import { configSafeDescription } from "@/utils/sanitizeHTML";
import type { ArticleBlog } from "@/types/types";
import Carousel from "@/components/Carousel";
import ProjectLightbox from "@/components/project/ProjectLightBox";

import CardImageIcon from "../icons/CardImageIcon.astro";

interface Props {
  article: ArticleBlog;
  backHref?: string;
  backLabel?: string;
}

const { article, backHref = "/", backLabel = "Volver" } = Astro.props;
const hasMultipleImages = article.IMAGES?.length > 1;
const safeDescription = sanitizeHtml(
  article.DESCRIPTION,
  configSafeDescription,
);
---

<article class="relative w-full text-white">
  <!-- ── HERO ──────────────────────────────────────────────────── -->
  <header class="relative w-full min-h-[58vh] flex items-end overflow-hidden">
    {
      article.IMAGES?.[0] ? (
        <img
          src={article.IMAGES[0]}
          alt={article.TITLE}
          class="absolute inset-0 w-full h-full object-cover"
          loading="eager"
        />
      ) : (
        <div
          class="absolute inset-0"
          style="background:linear-gradient(135deg,rgba(2,18,28,0.95),rgba(6,182,212,0.06));"
        />
      )
    }

    <!-- Overlays -->
    <div
      class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/55 to-slate-950/10"
    >
    </div>
    <div
      class="absolute inset-0 bg-gradient-to-r from-slate-950/65 via-transparent to-transparent"
    >
    </div>

    <!-- Contenido hero -->
    <div
      class="hero-content relative z-10 w-full max-w-3xl px-4 sm:px-8 pb-10 pt-28 flex flex-col gap-4"
    >
      <!-- Volver -->
      <a
        href={backHref}
        class="group self-start flex items-center gap-2 text-[11px] tracking-[0.2em] uppercase text-white/35 hover:text-cyan-300 transition-colors duration-200"
      >
        <svg
          class="w-3 h-3 group-hover:-translate-x-0.5 transition-transform duration-200"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2.5"
            d="M15 19l-7-7 7-7"></path>
        </svg>
        {backLabel}
      </a>

      <!-- Tags -->
      {
        article.TAGS?.length > 0 && (
          <div class="flex flex-wrap gap-2">
            {article.TAGS.map((tag) => (
              <span
                class="text-[9px] tracking-[0.22em] uppercase font-medium px-2.5 py-0.5 rounded-full"
                style="background:rgba(6,182,212,0.1); border:1px solid rgba(6,182,212,0.28); color:rgba(103,232,249,0.8);"
              >
                {tag}
              </span>
            ))}
          </div>
        )
      }

      <!-- Título -->
      <h1
        class="text-3xl sm:text-4xl md:text-5xl font-extrabold uppercase leading-tight tracking-tight"
        style="background:linear-gradient(135deg,#ffffff 30%,#67e8f9 70%,#0891b2 100%); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text;"
      >
        {article.TITLE}
      </h1>

      <!-- Meta -->
      <div class="flex items-center gap-3">
        <div
          class="w-1.5 h-1.5 rounded-full bg-cyan-400 shadow-[0_0_6px_rgba(6,182,212,0.9)]"
        >
        </div>
        <time class="text-xs tabular-nums" style="color:rgba(255,255,255,0.35);"
          >{article.DATE}</time
        >
        <span style="color:rgba(255,255,255,0.15);">·</span>
        <span class="text-[10px] font-mono" style="color:rgba(255,255,255,0.2);"
          >#{article.ID}</span
        >
      </div>
    </div>
  </header>

  <!-- ── CUERPO ─────────────────────────────────────────────────── -->
  <div
    class="article-layout max-w-3xl mx-auto px-4 sm:px-8 py-12 flex flex-col gap-10"
  >
    <!-- Separador superior -->
    <div
      class="w-full h-px"
      style="background:linear-gradient(to right,rgba(6,182,212,0.4),transparent);"
    >
    </div>

    <!-- Contenido editorial -->
    <div class="prose-wrapper relative">
      <!-- Línea vertical izquierda -->
      <div
        class="accent-line absolute -left-5 top-1 bottom-1 w-px hidden sm:block"
        style="background:linear-gradient(to bottom,rgba(6,182,212,0.4),transparent);"
      >
      </div>

      <div class="article-body" set:html={safeDescription} />
    </div>

    <!-- Galería secundaria -->
    {
      article.IMAGES.length > 0 && (
        <section class="flex flex-col gap-4">
          <div class="flex items-center gap-2.5">
            <div
              class="w-1 h-1 rounded-full"
              style="background:rgba(6,182,212,0.6);"
            />
            <span
              class="text-[10px] tracking-[0.22em] uppercase flex items-center gap-1.5"
              style="color:rgba(255,255,255,0.3);"
            >
              <svg
                class="w-3 h-3"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
                />
              </svg>
              Galería
              <span style="color:rgba(255,255,255,0.18);">
                ({article.IMAGES.length - 1})
              </span>
            </span>
          </div>

          {article.IMAGES && article.IMAGES.length > 0 && (
            <section class="flex flex-col gap-4">
              <ProjectLightbox
                images={article.IMAGES as string[]}
                name={article.TITLE}
                client:load
              />
            </section>
          )}

        </section>
      )
    }

    <!-- Separador final -->
    <div
      class="w-full h-px"
      style="background:linear-gradient(to right,transparent,rgba(6,182,212,0.2),transparent);"
    >
    </div>

    <!-- Footer -->
    <footer class="flex flex-wrap items-center justify-between gap-4">
      <div class="flex flex-wrap gap-2">
        {
          article.TAGS?.map((tag) => (
            <span
              class="text-[9px] tracking-[0.2em] uppercase px-2.5 py-0.5 rounded-full"
              style="background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.07); color:rgba(255,255,255,0.3);"
            >
              {tag}
            </span>
          ))
        }
      </div>
      <a
        href={backHref}
        class="group flex items-center gap-2 text-xs transition-colors duration-200"
        style="color:rgba(255,255,255,0.35);"
        onmouseover="this.style.color='rgba(103,232,249,1)'"
        onmouseout="this.style.color='rgba(255,255,255,0.35)'"
      >
        <svg
          class="w-3 h-3 group-hover:-translate-x-0.5 transition-transform duration-200"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2.5"
            d="M15 19l-7-7 7-7"></path>
        </svg>
        {backLabel}
      </a>
    </footer>
  </div>
</article>

<style is:global>
  /* ── Entrada ─────────────────────────────────────────────────── */
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .hero-content {
    animation: fadeUp 0.55s ease both;
  }
  .article-layout {
    animation: fadeUp 0.5s ease both;
    animation-delay: 0.12s;
    opacity: 0;
  }

  /* ── Tipografía editorial ─────────────────────────────────────── */
  .article-body {
    color: rgba(255, 255, 255, 0.68);
    font-size: clamp(0.9rem, 1vw + 0.5rem, 1.05rem);
    line-height: 1.9;
  }

  /* Primera letra */
  .article-body > p:first-of-type::first-letter {
    float: left;
    font-size: 3.6em;
    line-height: 0.82;
    font-weight: 800;
    color: rgba(103, 232, 249, 0.85);
    margin: 0.05em 0.12em 0 0;
  }

  .article-body p {
    margin: 0 0 1.5rem;
  }
  .article-body p:last-child {
    margin-bottom: 0;
  }

  /* Headings */
  .article-body h1,
  .article-body h2,
  .article-body h3,
  .article-body h4 {
    font-weight: 700;
    margin: 2.2rem 0 0.6rem;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }
  .article-body h1 {
    font-size: 1.6rem;
    color: rgba(255, 255, 255, 0.95);
    padding-bottom: 0.6rem;
    border-bottom: 2px solid rgba(6, 182, 212, 0.2);
  }
  .article-body h2 {
    font-size: 1.2rem;
    color: rgba(255, 255, 255, 0.9);
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(6, 182, 212, 0.15);
  }
  .article-body h3 {
    font-size: 1.02rem;
    color: rgba(255, 255, 255, 0.85);
  }
  .article-body h4 {
    font-size: 0.85rem;
    color: rgba(103, 232, 249, 0.65);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  /* Inline */
  .article-body strong,
  .article-body b {
    font-weight: 700;
    color: rgba(255, 255, 255, 0.9);
  }
  .article-body em,
  .article-body i {
    font-style: italic;
    color: rgba(103, 232, 249, 0.75);
  }
  .article-body mark {
    background: rgba(6, 182, 212, 0.18);
    color: rgba(103, 232, 249, 0.95);
    border-radius: 3px;
    padding: 0.05em 0.28em;
  }
  .article-body del,
  .article-body s {
    color: rgba(255, 255, 255, 0.28);
  }

  /* Links */
  .article-body a {
    color: rgba(6, 182, 212, 0.85);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    text-decoration-color: rgba(6, 182, 212, 0.3);
    transition:
      color 0.15s,
      text-decoration-color 0.15s;
  }
  .article-body a:hover {
    color: rgba(103, 232, 249, 1);
    text-decoration-color: rgba(103, 232, 249, 0.6);
  }

  /* Lists */
  .article-body ul,
  .article-body ol {
    padding-left: 1.5rem;
    margin: 0 0 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .article-body ul {
    list-style: none;
  }
  .article-body ul > li {
    position: relative;
  }
  .article-body ul > li::before {
    content: "—";
    position: absolute;
    left: -1.5rem;
    color: rgba(6, 182, 212, 0.6);
    font-weight: 600;
    font-size: 0.9em;
  }
  .article-body ol {
    list-style: decimal;
  }
  .article-body ol > li::marker {
    color: rgba(6, 182, 212, 0.55);
    font-weight: 700;
    font-size: 0.85em;
  }

  /* Blockquote */
  .article-body blockquote {
    margin: 1.8rem 0;
    padding: 1rem 1.4rem;
    border-left: 2px solid rgba(6, 182, 212, 0.45);
    background: rgba(6, 182, 212, 0.04);
    border-radius: 0 10px 10px 0;
    font-style: italic;
    color: rgba(255, 255, 255, 0.45);
    font-size: 1.04em;
    line-height: 1.72;
  }
  .article-body blockquote p {
    margin: 0;
  }

  /* Code */
  .article-body code {
    font-family: ui-monospace, "Cascadia Code", monospace;
    font-size: 0.8em;
    color: rgba(103, 232, 249, 0.85);
    background: rgba(6, 182, 212, 0.08);
    border: 1px solid rgba(6, 182, 212, 0.18);
    padding: 0.12em 0.42em;
    border-radius: 4px;
  }
  .article-body pre {
    background: rgba(2, 8, 14, 0.8);
    border: 1px solid rgba(6, 182, 212, 0.12);
    border-radius: 12px;
    padding: 1.1rem 1.3rem;
    overflow-x: auto;
    margin: 1.5rem 0;
    scrollbar-width: thin;
    scrollbar-color: rgba(6, 182, 212, 0.2) transparent;
  }
  .article-body pre code {
    background: none;
    border: none;
    padding: 0;
    font-size: 0.83rem;
    color: rgba(255, 255, 255, 0.7);
  }

  /* HR */
  .article-body hr {
    border: none;
    height: 1px;
    background: linear-gradient(
      to right,
      transparent,
      rgba(6, 182, 212, 0.3),
      transparent
    );
    margin: 2.2rem 0;
    position: relative;
  }
  .article-body hr::after {
    content: "✦";
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    background: transparent;
    padding: 0 12px;
    color: rgba(6, 182, 212, 0.4);
    font-size: 0.65rem;
  }

  /* Table */
  .article-body table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
    margin: 1.5rem 0;
    display: block;
    overflow-x: auto;
    border-radius: 10px;
    border: 1px solid rgba(6, 182, 212, 0.1);
  }
  .article-body th,
  .article-body td {
    padding: 0.5rem 0.9rem;
    border-bottom: 1px solid rgba(6, 182, 212, 0.08);
    text-align: left;
    white-space: nowrap;
  }
  .article-body th {
    background: rgba(6, 182, 212, 0.07);
    color: rgba(103, 232, 249, 0.75);
    font-weight: 600;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
  }
  .article-body tr:last-child td {
    border-bottom: none;
  }
  .article-body tr:hover td {
    background: rgba(255, 255, 255, 0.02);
  }

  /* Figure */
  .article-body figure {
    margin: 1.8rem 0;
  }
  .article-body figcaption {
    font-size: 0.76rem;
    color: rgba(255, 255, 255, 0.3);
    text-align: center;
    margin-top: 0.5rem;
    font-style: italic;
  }

  /* ── Responsive ─────────────────────────────────────────────── */
  @media (max-width: 640px) {
    .article-body > p:first-of-type::first-letter {
      font-size: 3em;
    }
  }
</style>
