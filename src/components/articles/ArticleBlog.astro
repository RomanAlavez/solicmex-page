---
import type { ArticleBlog } from "@/types/types";

interface Props {
  article: ArticleBlog;
  backHref?: string;
  backLabel?: string;
}

const { article, backHref = "/", backLabel = "Volver" } = Astro.props;
const hasMultipleImages = article.IMAGES?.length > 1;

// ── Sanitización del HTML ────────────────────────────────────────────────────
// Lista blanca de tags permitidos para contenido editorial.
const ALLOWED_TAGS = new Set([
  "p","br","b","strong","i","em","u","s","del","mark","small","sub","sup",
  "h2","h3","h4","h5","h6",
  "ul","ol","li",
  "blockquote","pre","code",
  "a","hr",
  "table","thead","tbody","tr","th","td",
  "figure","figcaption",
]);

// Atributos permitidos por tag.
const ALLOWED_ATTRS: Record<string, Set<string>> = {
  a:    new Set(["href", "title", "target", "rel"]),
  td:   new Set(["colspan", "rowspan"]),
  th:   new Set(["colspan", "rowspan", "scope"]),
  code: new Set(["class"]),
  pre:  new Set(["class"]),
};

function sanitizeHref(href: string): string {
  try {
    const url = new URL(href, "https://example.com");
    if (!["http:", "https:", "mailto:"].includes(url.protocol)) return "#";
  } catch {
    return "#";
  }
  return href;
}

function sanitize(raw: string): string {
  if (!raw) return "";

  return raw
    // 1. Eliminar bloques completos de tags peligrosos (con su contenido)
    .replace(/<(script|style|iframe|object|embed|form|svg|math)[^>]*>[\s\S]*?<\/\1>/gi, "")
    // 2. Eliminar tags de auto-cierre peligrosos
    .replace(/<(script|style|iframe|object|embed|form|input|button|select|textarea|meta|link|base)[^>]*\/?>/gi, "")
    // 3. Eliminar comentarios HTML
    .replace(/<!--[\s\S]*?-->/g, "")
    // 4. Eliminar manejadores de eventos inline (onclick, onload, etc.)
    .replace(/\s+on[a-z]+\s*=\s*(?:"[^"]*"|'[^']*'|[^\s>]*)/gi, "")
    // 5. Eliminar protocolos peligrosos en cualquier contexto
    .replace(/\b(javascript|vbscript|data)\s*:/gi, "")
    // 6. Procesar <a> por separado para sanitizar href y forzar rel externo
    .replace(/<a([^>]*)>/gi, (_match, attrs: string) => {
      const hrefMatch = attrs.match(/href\s*=\s*["']([^"']*)["']/i);
      const href      = hrefMatch ? sanitizeHref(hrefMatch[1]) : null;
      const titleMatch = attrs.match(/title\s*=\s*["']([^"']*)["']/i);
      const title     = titleMatch ? ` title="${titleMatch[1].replace(/"/g, "&quot;")}"` : "";
      const isExternal = href && !href.startsWith("#") && !href.startsWith("/");
      return href
        ? `<a href="${href}"${title}${isExternal ? ' target="_blank" rel="noopener noreferrer"' : ""}>`
        : "<a>";
    })
    // 7. Eliminar tags no permitidos (preservando su contenido de texto)
    .replace(/<\/?([a-zA-Z][a-zA-Z0-9]*)[^>]*>/gi, (match, tag: string) => {
      if (ALLOWED_TAGS.has(tag.toLowerCase())) return match;
      return "";
    })
    // 8. En tags permitidos, filtrar atributos no en la lista blanca
    .replace(/<([a-zA-Z][a-zA-Z0-9]*)([^>]*)>/gi, (_match, tag: string, attrs: string) => {
      const lTag = tag.toLowerCase();
      if (lTag === "a") return _match; // ya procesado en paso 6
      const allowed = ALLOWED_ATTRS[lTag];
      if (!allowed || allowed.size === 0) return `<${lTag}>`;
      const safeAttrs = [...attrs.matchAll(/([a-zA-Z-]+)\s*=\s*["']([^"']*)["']/g)]
        .filter(([, name]) => allowed.has(name.toLowerCase()))
        .map(([, name, val]) => `${name}="${val.replace(/"/g, "&quot;")}"`)
        .join(" ");
      return safeAttrs ? `<${lTag} ${safeAttrs}>` : `<${lTag}>`;
    });
}

const safeDescription = sanitize(article.DESCRIPTION);
---

<article class="relative w-full text-white">

  <!-- ── HERO DEL ARTÍCULO ─────────────────────────────────── -->
  <div class="relative w-full min-h-[52vh] flex items-end overflow-hidden">

    {article.IMAGES?.[0] ? (
      <img
        src={article.IMAGES[0]}
        alt={article.TITLE}
        class="absolute inset-0 w-full h-full object-cover"
        loading="eager"
      />
    ) : (
      <div
        class="absolute inset-0"
        style="background: linear-gradient(135deg, rgba(2,18,28,0.9), rgba(6,182,212,0.08));"
      ></div>
    )}

    <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/60 to-slate-950/20"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-slate-950/70 via-transparent to-transparent"></div>

    <div class="relative w-full px-4 sm:px-8 pb-10 pt-24 flex flex-col gap-4 max-w-4xl">
      <a
        href={backHref}
        class="group self-start flex items-center gap-2 text-[11px] tracking-widest uppercase text-white/40 hover:text-cyan-300 transition-colors duration-200"
      >
        <svg class="w-3 h-3 group-hover:-translate-x-0.5 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        {backLabel}
      </a>

      {article.TAGS?.length > 0 && (
        <div class="flex flex-wrap gap-2">
          {article.TAGS.map((tag) => (
            <span
              class="text-[9px] tracking-[0.22em] uppercase font-medium px-2.5 py-0.5 rounded-full"
              style="background:rgba(6,182,212,0.1); border:1px solid rgba(6,182,212,0.25); color:rgba(103,232,249,0.75);"
            >
              {tag}
            </span>
          ))}
        </div>
      )}

      <h1
        class="text-3xl sm:text-4xl md:text-5xl font-extrabold uppercase leading-tight tracking-tight"
        style="background:linear-gradient(135deg,#ffffff 30%,#67e8f9 75%,#0891b2 100%); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text;"
      >
        {article.TITLE}
      </h1>

      <div class="flex items-center gap-3">
        <div class="w-1.5 h-1.5 rounded-full bg-cyan-400 shadow-[0_0_6px_rgba(6,182,212,0.8)]"></div>
        <time class="text-xs text-white/35 tabular-nums">{article.DATE}</time>
        <span class="text-white/15 text-xs">·</span>
        <span class="text-[10px] text-white/20 font-mono">#{article.ID}</span>
      </div>
    </div>
  </div>

  <!-- ── CUERPO DEL ARTÍCULO ───────────────────────────────── -->
  <div class="max-w-4xl mx-auto px-4 sm:px-8 py-12 flex flex-col gap-10">

    <div class="w-full h-px" style="background:linear-gradient(to right, rgba(6,182,212,0.35), transparent);"></div>

    <!-- HTML sanitizado del artículo -->
    <div
      class="article-body rounded-2xl px-6 py-5"
      style="background:rgba(2,14,22,0.5); border:1px solid rgba(6,182,212,0.1); backdrop-filter:blur(10px);"
      set:html={safeDescription}
    />

    {hasMultipleImages && (
      <div class="flex flex-col gap-4">
        <div class="flex items-center gap-2.5">
          <div class="w-1 h-1 rounded-full bg-cyan-400/60"></div>
          <span class="text-[10px] tracking-[0.22em] uppercase text-white/30">Galería</span>
          <span class="text-[10px] text-white/20">({article.IMAGES.length - 1})</span>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5">
          {article.IMAGES.slice(1).map((src, i) => (
            <div
              class={[
                "group relative overflow-hidden rounded-xl border border-white/5 hover:border-cyan-400/20 transition-colors duration-300",
                i === 0 && article.IMAGES.length > 3 ? "col-span-2 sm:col-span-2 aspect-video" : "aspect-video"
              ].join(" ")}
            >
              <img
                src={src}
                alt={`${article.TITLE} — imagen ${i + 2}`}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
              />
              <div
                class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300"
                style="background:linear-gradient(to top, rgba(2,12,20,0.5), transparent);"
              ></div>
              <span
                class="absolute bottom-2 right-2 text-[10px] font-mono tabular-nums opacity-0 group-hover:opacity-100 transition-opacity duration-300"
                style="color:rgba(103,232,249,0.6);"
              >
                {String(i + 2).padStart(2, "0")}
              </span>
            </div>
          ))}
        </div>
      </div>
    )}

    <div class="w-full h-px" style="background:linear-gradient(to right, transparent, rgba(6,182,212,0.2), transparent);"></div>

    <div class="flex flex-wrap items-center justify-between gap-4">
      <div class="flex flex-wrap gap-2">
        {article.TAGS?.map((tag) => (
          <span
            class="text-[9px] tracking-[0.2em] uppercase px-2.5 py-0.5 rounded-full text-white/35"
            style="background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.07);"
          >
            {tag}
          </span>
        ))}
      </div>
      <a
        href={backHref}
        class="group flex items-center gap-2 text-xs text-white/40 hover:text-cyan-300 transition-colors duration-200"
      >
        <svg class="w-3 h-3 group-hover:-translate-x-0.5 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        {backLabel}
      </a>
    </div>

  </div>
</article>

<style>
  /* ── Tipografía editorial para el HTML del artículo ─────── */
  .article-body {
    color: rgba(255,255,255,0.65);
    font-size: 0.9rem;
    line-height: 1.85;
  }

  .article-body h2,
  .article-body h3,
  .article-body h4 {
    color: rgba(255,255,255,0.9);
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }
  .article-body h2 { font-size: 1.2rem; }
  .article-body h3 { font-size: 1.02rem; }
  .article-body h4 { font-size: 0.93rem; color: rgba(255,255,255,0.7); }

  .article-body p { margin-bottom: 1rem; }
  .article-body p:last-child { margin-bottom: 0; }

  .article-body strong, .article-body b {
    color: rgba(255,255,255,0.88);
    font-weight: 600;
  }
  .article-body em, .article-body i {
    color: rgba(103,232,249,0.75);
    font-style: italic;
  }
  .article-body mark {
    background: rgba(6,182,212,0.18);
    color: rgba(103,232,249,0.9);
    border-radius: 3px;
    padding: 0 0.25em;
  }
  .article-body del, .article-body s {
    color: rgba(255,255,255,0.3);
  }

  .article-body a {
    color: rgba(6,182,212,0.85);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(6,182,212,0.3);
    transition: color 0.2s, text-decoration-color 0.2s;
  }
  .article-body a:hover {
    color: rgba(103,232,249,1);
    text-decoration-color: rgba(103,232,249,0.6);
  }

  .article-body ul,
  .article-body ol {
    padding-left: 1.4rem;
    margin-bottom: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .article-body ul { list-style: none; }
  .article-body ul > li::before {
    content: "·";
    color: rgba(6,182,212,0.6);
    font-weight: 700;
    display: inline-block;
    width: 1rem;
    margin-left: -1rem;
  }
  .article-body ol { list-style: decimal; }
  .article-body ol > li::marker { color: rgba(6,182,212,0.5); }

  .article-body blockquote {
    border-left: 2px solid rgba(6,182,212,0.4);
    padding: 0.55rem 1rem;
    margin: 1.25rem 0;
    color: rgba(255,255,255,0.42);
    font-style: italic;
    background: rgba(6,182,212,0.04);
    border-radius: 0 8px 8px 0;
  }

  .article-body code {
    font-family: ui-monospace, "Cascadia Code", monospace;
    font-size: 0.8em;
    color: rgba(103,232,249,0.8);
    background: rgba(6,182,212,0.08);
    border: 1px solid rgba(6,182,212,0.15);
    padding: 0.1em 0.4em;
    border-radius: 4px;
  }
  .article-body pre {
    background: rgba(2,10,16,0.75);
    border: 1px solid rgba(6,182,212,0.12);
    border-radius: 12px;
    padding: 1rem 1.25rem;
    overflow-x: auto;
    margin: 1.25rem 0;
    scrollbar-width: thin;
    scrollbar-color: rgba(6,182,212,0.2) transparent;
  }
  .article-body pre code {
    background: none;
    border: none;
    padding: 0;
    font-size: 0.82rem;
    color: rgba(255,255,255,0.68);
  }

  .article-body hr {
    border: none;
    height: 1px;
    background: linear-gradient(to right, transparent, rgba(6,182,212,0.25), transparent);
    margin: 1.75rem 0;
  }

  .article-body table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.82rem;
    margin: 1.25rem 0;
    display: block;
    overflow-x: auto;
  }
  .article-body th,
  .article-body td {
    padding: 0.45rem 0.8rem;
    border: 1px solid rgba(6,182,212,0.1);
    text-align: left;
    white-space: nowrap;
  }
  .article-body th {
    color: rgba(103,232,249,0.7);
    font-weight: 600;
    background: rgba(6,182,212,0.06);
    letter-spacing: 0.04em;
  }
  .article-body tr:nth-child(even) td {
    background: rgba(255,255,255,0.02);
  }

  .article-body figure {
    margin: 1.5rem 0;
  }
  .article-body figcaption {
    font-size: 0.75rem;
    color: rgba(255,255,255,0.3);
    text-align: center;
    margin-top: 0.4rem;
    font-style: italic;
  }
</style>